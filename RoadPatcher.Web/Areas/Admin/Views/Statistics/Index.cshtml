@{
	ViewData["Title"] = "Statistics";
}

<div class="row g-5">
	<div class="col-12">
		<div class="card shadow-sm mb-5">
			<div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
				<div>
					<h1 class="mb-2">Statistics Map</h1>
					<p class="text-muted mb-0">Draw a polygon to load posts inside the selected boundary. Only one shape stays active at a time.</p>
				</div>
				<div class="d-flex align-items-center gap-3">
					<div class="text-end">
						<div class="text-muted small">Posts in Shape</div>
						<div id="boundaryPostCount" class="fs-2 fw-bold">0</div>
					</div>
					<div class="text-end">
						<div class="text-muted small">Total Raised</div>
						<div id="boundaryTotalRaised" class="fs-2 fw-bold">Rs. 0</div>
					</div>
					<button id="clearBoundaryShape" type="button" class="btn btn-light-danger">Clear Shape</button>
				</div>
			</div>
		</div>
	</div>

	<div class="col-lg-8">
		<div class="card shadow-sm h-100">
			<div class="card-body p-0">
				<div id="admin-statistics-map" style="height: 70vh; width: 100%;"></div>
			</div>
		</div>
	</div>

	<div class="col-lg-4">
		<div class="card shadow-sm h-100">
			<div class="card-body">
				<h3 class="mb-3">How it works</h3>
				<ul class="text-muted mb-0 ps-3">
					<li>Choose the polygon tool on the map.</li>
					<li>Draw a boundary around the area you want to inspect.</li>
					<li>The previous shape is removed automatically when a new one is drawn.</li>
					<li>Posts inside the boundary are fetched with PostGIS and shown as markers.</li>
				</ul>
			</div>
		</div>
	</div>
</div>