@{
	ViewData["Title"] = "Statistics";
}

<div class="row g-5">

	<h1 class="mb-2">Statistics</h1>

	<div class="col-lg-8">
		<div class="card shadow-sm h-100">
			<div class="card-body p-0">
				<div id="admin-statistics-map" style="height: 70vh; width: 100%;"></div>
			</div>
		</div>
	</div>

	<div class="col-lg-4">
		<div class="card shadow-sm h-100">
			<div class="card-body">
				<h3 class="mb-3">How it works</h3>
				<ul class="text-muted mb-0 ps-3">
					<li>Choose the polygon tool on the map.</li>
					<li>Draw a boundary around the area you want to inspect.</li>
					<li>The previous shape is removed automatically when a new one is drawn.</li>
					<li>Posts with details and donations inside the boundary are fetched.</li>
				</ul>
				<hr />
				<div class="row text-center g-3 mt-2 post_stats d-none">
					<div class="col-12">
						<h4 class="mb-0">Posts</h4>
					</div>
					<div class="col-6">
						<div class="text-muted small">Total</div>
						<div id="boundaryTotalCount" class="fs-4 fw-bold">0</div>
					</div>
					<div class="col-6">
						<div class="text-muted small">Pending</div>
						<div id="boundaryPendingCount" class="fs-4 fw-bold">0</div>
					</div>
					<div class="col-6">
						<div class="text-muted small">In Process</div>
						<div id="boundaryInProcessCount" class="fs-4 fw-bold">0</div>
					</div>
					<div class="col-6">
						<div class="text-muted small">Completed</div>
						<div id="boundaryCompletedCount" class="fs-4 fw-bold">0</div>
					</div>
					<div class="col-12 mt-2">
						<h4 class="mb-0">Donation</h4>
					</div>
					<div class="col-6">
						<div class="text-muted small">Goal</div>
						<div id="boundaryGoal" class="fs-4 fw-bold">Rs. 0</div>
					</div>
					<div class="col-6">
						<div class="text-muted small">Received</div>
						<div id="boundaryReceived" class="fs-4 fw-bold">Rs. 0</div>
					</div>
				</div>

				<div class="text-center mt-4">
					<button id="clearBoundaryShape" type="button" class="btn btn-light-danger d-none">Clear Shape</button>
				</div>

			</div>
		</div>
	</div>
</div>

<div class="row g-5 mt-1 mb-10 donate_stats d-none">
	<div class="col-lg-6">
		<div class="card shadow-sm h-100">
			<div class="card-body">
				<div class="d-flex align-items-center justify-content-between mb-3">
					<div>
						<h3 class="mb-1">Donors</h3>
					</div>
				</div>

				<div class="table-responsive">
					<table class="table align-middle table-row-dashed table-hover mb-0">
						<thead>
							<tr class="text-muted fw-semibold fs-7 text-uppercase">
								<th style="width: 80px;">#</th>
								<th>User</th>
								<th class="text-end">Amount</th>
							</tr>
						</thead>
						<tbody id="boundaryDonatorsBody">
							<tr>
								<td colspan="3" class="text-center text-muted py-8">Draw a shape to load donor statistics.</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

	<div class="col-lg-6">
		<div class="card shadow-sm h-100">
			<div class="card-body">
				<div class="d-flex align-items-center justify-content-between mb-3">
					<div>
						<h3 class="mb-1">Donations</h3>
					</div>
				</div>

				<div class="table-responsive">
					<table class="table align-middle table-row-dashed table-hover mb-0">
						<thead>
							<tr class="text-muted fw-semibold fs-7 text-uppercase">
								<th style="width: 80px;">#</th>
								<th>User</th>
								<th class="text-end">Post</th>
								<th class="text-end">Amount</th>
								<th>Date</th>
							</tr>
						</thead>
						<tbody id="boundaryDonationsBody">
							<tr>
								<td colspan="5" class="text-center text-muted py-8">Draw a shape to load donation history.</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>