@using RoadPatcher.Application.Entities
@model ApplicationUser

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row g-5 justify-content-center">
	<div class="col-lg-8 mb-10">
		<div class="card">
			<div class="card-header">
				<h1 class="fs-2 m-0">Welcome to Admin Dashboard</h1>
			</div>
			<div class="card-body">
				<div class="mb-5">
				<p class="fs-5">Hello, <strong>@Model?.UserData?.FirstName @Model?.UserData?.LastName @Model?.Email</strong></p>
					<p class="text-muted">This is your admin dashboard. More features coming soon...</p>
				</div>
			</div>
		</div>
	</div>
</div>
