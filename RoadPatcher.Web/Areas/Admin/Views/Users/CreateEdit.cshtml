@model AdminUserCreateEditDto
@{
    Layout = "~/Views/Layout/Default.cshtml";
    ViewData["Title"] = Model?.Id != null ? "Edit User" : "Create User";

    var canManageRoles = ViewBag.CanManageRoles as bool? == true;
    var availableRoles = ViewBag.AvailableRoles as IEnumerable<string> ?? Enumerable.Empty<string>();
    var selectedRole = ViewBag.SelectedRole?.ToString() ?? Model?.Role ?? "User";
}

<div class="d-flex justify-content-between align-items-center mb-8">
    <h1 class="fs-3 fw-bold">@ViewData["Title"]</h1>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary">
        <i class="las la-arrow-left me-2"></i>Back to Users
    </a>
</div>

<div class="row g-5 justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">User Details</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-area="Admin" asp-controller="Users" asp-action="@(Model?.Id != null ? "Edit" : "Create")" asp-route-id="@Model?.Id">
                    @if (Model?.Id != null)
                    {
                        <input type="hidden" name="id" value="@Model.Id" />
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-5">
                        <label asp-for="Email" class="form-label required fw-semibold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="user@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="Password" class="form-label @(Model?.Id == null ? "required" : "") fw-semibold">
                            Password
                            @if (Model?.Id != null)
                            {
                                <small class="text-muted">(Leave empty to keep current password)</small>
                            }
                        </label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="@(Model?.Id == null ? "Enter password" : "New password (optional)")" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    @if (canManageRoles)
                    {
                        <div class="mb-5">
                            <label asp-for="Role" class="form-label required fw-semibold">Role</label>
                            <select asp-for="Role" class="form-select">
                                @foreach (var role in availableRoles)
                                {
                                    <option value="@role" selected="@(string.Equals(selectedRole, role, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@role</option>
                                }
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="las la-save me-2"></i>@(Model?.Id != null ? "Update User" : "Create User")
                        </button>
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
