@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<AdminUserListItemDto>
@{
    Layout = "~/Views/Layout/Default.cshtml";
    ViewData["Title"] = "Admin - Users";

    var canManageRoles = ViewBag.CanManageRoles as bool? == true;
    var selectedRole = ViewData["RoleFilter"]?.ToString();
    var availableRoles = ViewBag.AvailableRoles as IEnumerable<string> ?? Enumerable.Empty<string>();
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="d-flex justify-content-between align-items-center mb-8">
    <h1 class="fs-3 fw-bold">Users Management</h1>
    <a asp-area="Admin" asp-controller="Users" asp-action="Create" asp-route-returnUrl="@returnUrl" class="btn btn-primary">
        Add User
    </a>
</div>

<div class="card mb-8">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-lg-@(canManageRoles ? 8 : 11)">
                <label class="form-label fw-semibold">Search</label>
                <input type="text" name="search" class="form-control" placeholder="Search by email, name, or address..." value="@ViewData["Search"]" />
            </div>

            @if (canManageRoles)
            {
                <div class="col-lg-3">
                    <label class="form-label fw-semibold">Role Filter</label>
                    <select name="role" class="form-select form-control">
                        <option value="">All Roles</option>
                        @foreach (var role in availableRoles)
                        {
                            <option value="@role" selected="@(string.Equals(selectedRole, role, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@role</option>
                        }
                    </select>
                </div>
            }

            <div class="col-lg-1 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 search-btn">Search</button>
            </div>

            <div class="col-12">
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-page="@Model.PageNumber" class="btn btn-light-secondary btn-sm">Clear filters</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Users List</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            @if (Model.Count > 0)
            {
                <table class="table table-row-bordered align-middle gy-4 gs-9">
                    <thead class="border-bottom border-gray-200 fs-6 text-gray-600 fw-bold bg-light bg-opacity-75">
                        <tr>
                            <th>Email</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Address</th>
                            <th>Google Address</th>
                            <th>Image</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var isAdminUser = user.Roles.Contains("Admin", StringComparer.OrdinalIgnoreCase);
                            var isDisabled = user.IsDisabled;
                            <tr>
                                <td class="fw-semibold">@user.Email</td>
                                <td>@user.FirstName</td>
                                <td>@user.LastName</td>
                                <td><small>@user.Address</small></td>
                                <td><small>@user.GoogleAddress</small></td>
                                @{

                                    var roleClass = "light-warning";

                                    if(user.PrimaryRole == "Admin") {
                                        roleClass = "light-success";

                                    }
                                }
                                <td class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(user.Image) && !user.Image.EndsWith("profile.png", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <img src="@user.Image" class="img-fluid rounded" style="max-width: 40px; max-height: 40px;" alt="Profile" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><span class="badge bg-@roleClass">@user.PrimaryRole</span></td>
                                <td class="text-center">
                                    @if (!isAdminUser || canManageRoles)
                                    {
                                        <div class="form-check form-switch mb-0">
                                            <input
                                                class="form-check-input js-user-status-toggle"
                                                type="checkbox"
                                                role="switch"
                                                data-user-id="@user.Id"
                                                data-url="@Url.Action("ToggleStatus", "Users", new { area = "Admin", id = user.Id })"
                                                @(isDisabled ? string.Empty : "checked") />
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        @if (!isAdminUser || canManageRoles)
                                        {
                                            <a asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" asp-route-returnUrl="@returnUrl" class="btn btn-light btn-edit">
                                                <i class="las la-edit fz-24"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-8">
                    <div class="alert alert-info mb-0" role="alert">
                        No users found.
                    </div>
                </div>
            }
        </div>

        @if (Model.PageCount > 1)
        {
            <div class="d-flex justify-content-center mt-8">
                @Html.PagedListPager(
                    Model,
                    page => Url.Action("Index", new { page, search = ViewData["Search"], role = selectedRole }),
                    new PagedListRenderOptions
                    {
                        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                        DisplayLinkToNextPage = PagedListDisplayMode.Always,
                        MaximumPageNumbersToDisplay = 5,
                        LinkToPreviousPageFormat = "<i class=\"las la-angle-left\"></i>",
                        LinkToNextPageFormat = "<i class=\"las la-angle-right\"></i>",
                        LiElementClasses = ["page-item"],
                        PageClasses = ["page-link"],
                        UlElementClasses = ["pagination", "justify-content-center", "mb-10"]
                    }
                )
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            $(document).on('change', '.js-user-status-toggle', function () {
                const toggle = this;
                const $toggle = $(toggle);
                const url = $toggle.data('url');
                const isChecked = toggle.checked;

                $toggle.prop('disabled', true);

                $.ajax({
                    url: url,
                    method: 'POST',
                    data: {
                        __RequestVerificationToken: antiForgeryToken
                    },
                    success: function (response) {
                        if (!response || !response.success) {
                            const message = response && response.message ? response.message : 'Failed to update user status.';
                            if (window.toastr) {
                                toastr.error(message);
                            } else {
                                alert(message);
                            }
                            return;
                        }

                        if (window.toastr) {
                            toastr.success(response.message);
                        }
                    },
                    error: function () {
                        const message = 'Failed to update user status.';
                        if (window.toastr) {
                            toastr.error(message);
                        } else {
                            alert(message);
                        }
                    },
                    complete: function () {
                        $toggle.prop('disabled', false);
                    }
                });
            });

        })();
    </script>
}

