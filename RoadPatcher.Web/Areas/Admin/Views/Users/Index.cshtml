@{
    Layout = "~/Views/Layout/Default.cshtml";
    ViewData["Title"] = "Admin - Users";
}

<div class="d-flex justify-content-between align-items-center mb-8">
    <h1 class="fs-3 fw-bold">Users Management</h1>
    <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-primary">
        <i class="las la-plus me-2"></i>Add User
    </a>
</div>

<!-- Search Bar -->
<div class="card mb-8">
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index" class="d-flex gap-2">
            <input type="text" name="search" class="form-control" placeholder="Search by email, name, or address..." value="@ViewData["Search"]" />
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary">Clear</a>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Users List</h5>
    </div>
    <div class="card-body">
        <div class="dt-container dt-bootstrap5 dt-empty-footer">
            <div class="table-responsive">
                @if (Model.Count > 0)
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr class="table-light">
                                <th class="w-10">Email</th>
                                <th class="w-10">First Name</th>
                                <th class="w-10">Last Name</th>
                                <th class="w-15">Address</th>
                                <th class="w-15">Google Address</th>
                                <th class="w-10">Role</th>
                                <th class="w-5">Image</th>
                                <th class="w-15">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@user.Email</span>
                                    </td>
                                    <td>@user.FirstName</td>
                                    <td>@user.LastName</td>
                                    <td>
                                        <small>@user.Address</small>
                                    </td>
                                    <td>
                                        <small>@user.GoogleAddress</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@user.Role</span>
                                    </td>
                                    <td>
                                        @if (!user.Image.EndsWith("profile.png"))
                                        {
                                            <img src="@user.Image" class="img-fluid rounded" style="max-width: 40px; max-height: 40px;" alt="Profile" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-light btn-sm">
                                                <i class="las la-edit"></i> Edit
                                            </a>
                                            <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal@user.Id">
                                                <i class="las la-trash"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteModal@user.Id" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Are you sure you want to delete this user <strong>@user.Email</strong>?</p>
                                                <p class="text-danger">This action cannot be undone.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form method="post" asp-area="Admin" asp-controller="Users" asp-action="Delete" asp-route-id="@user.Id" style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-8">
                        <div class="alert alert-info" role="alert">
                            No users found.
                        </div>
                    </div>
                }
            </div>

            @if (Model.PageCount > 1)
            {
                <div class="row">
                    <div class="mt-8 d-flex justify-content-center">
                        <nav aria-label="Page navigation">
                            <ul class="pagination">
                                @if (Model.HasPreviousPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@ViewData["Search"]">
                                            <i class="las la-angle-left"></i> Previous
                                        </a>
                                    </li>
                                }

                                @for (int i = 1; i <= Model.PageCount; i++)
                                {
                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                        <a class="page-link" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewData["Search"]">
                                            @i
                                        </a>
                                    </li>
                                }

                                @if (Model.HasNextPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@ViewData["Search"]">
                                            Next <i class="las la-angle-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

