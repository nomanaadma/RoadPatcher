@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
    Layout = KTTheme.GetView("Auth.cshtml");
}


<div class="row">
	<div>
	<!--begin::Heading-->
	<div class="text-center mb-4">
			
		<img alt="Logo" src="~/img/default-dark.png" class="h-60px h-lg-75px mb-4"/>
			
		<!--begin::Title-->
		<h1 class="text-gray-900 fw-bolder">
			@ViewData["Title"]
		</h1>
		<p class="mb-0">
			Please check your email to reset your password. 
		</p>
		@if (@Model.ResetUrl != null)
		{
			<p>or <a href="@Model.ResetUrl">Click here</a></p>	
		}
		<!--end::Title-->
	</div>
	<!--begin::Heading-->
	</div>
</div>