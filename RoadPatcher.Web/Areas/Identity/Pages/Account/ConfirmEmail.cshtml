@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
    Layout = KTTheme.GetView("Auth.cshtml");
}

<div class="row">
	<div>
	<!--begin::Heading-->
	<div class="text-center mb-4">
			
		<img alt="Logo" src="~/img/default-dark.png" class="h-60px h-lg-75px mb-4"/>
			
		<!--begin::Title-->
		<h1 class="text-gray-900 fw-bolder">
			@ViewData["Title"]
		</h1>
		<partial name="_StatusMessage" model="Model.StatusMessage" />
		<div>
			<p>
				<a asp-page="./Login">Sign In</a>
			</p>
		</div>
		<!--end::Title-->
	</div>
	<!--begin::Heading-->
	</div>
</div>
