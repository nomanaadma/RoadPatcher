@page
@model LoginModel

@{
    ViewData["Title"] = "Sign in";
    Layout = KTTheme.GetView("Auth.cshtml");
}
<div class="row">
    <div>
        <section>
            <form id="account" method="post">

                <!--begin::Heading-->
                <div class="text-center mb-11">

                    <img alt="Logo" src="~/img/default-dark.png" class="h-60px h-lg-75px mb-4"/>

                    <!--begin::Title-->
                    <h1 class="text-gray-900 fw-bolder">
                        @ViewData["Title"]
                    </h1>
                    <!--end::Title-->
                </div>
                <!--begin::Heading-->

                <!--begin::Separator-->
                <div class="separator separator-content my-9">
                    <span class="w-300px text-gray-500 fw-semibold fs-7">Welcome to RoadPatcher</span>
                </div>
                <!--end::Separator-->
                
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-5">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
                    <label asp-for="Input.Email" class="form-label text-gray-600"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-5">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password"/>
                    <label asp-for="Input.Password" class="form-label text-gray-600"></label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="checkbox mb-5">
                    <label asp-for="Input.RememberMe" class="form-label text-gray-600">
                        <input class="form-check-input" asp-for="Input.RememberMe"/>
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div class="mb-5">
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
                </div>
                <div>
                    <p class="d-flex flex-column">
	                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
	                    <a asp-page="./ForgotPassword">Forgot Password</a>
	                    <a asp-page="./ResendEmailConfirmation">Resend Email Confirmation</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
