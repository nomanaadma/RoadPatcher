@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate recovery codes";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header card-header-secondary">
                    <h1 class="fs-2 m-0">@ViewData["Title"]</h1>
                </div>
                <div class="card-body">
                    <partial name="~/Areas/Identity/Pages/Account/_StatusMessage.cshtml" model="Model.StatusMessage" />

                    @if (Model.RecoveryCodes is null)
                    {
                        <p>Generating new recovery codes will invalidate all previously generated codes.</p>
                        <form method="post">
                            <button type="submit" class="btn btn-warning btn-sm">Generate recovery codes</button>
                            <a asp-page="./TwoFactorAuthentication" class="btn btn-secondary btn-sm ms-2">Back</a>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <h5 class="mb-3">Store these recovery codes safely</h5>
                            <ul class="mb-0">
                                @foreach (var code in Model.RecoveryCodes)
                                {
                                    <li><code>@code</code></li>
                                }
                            </ul>
                        </div>
                        <a asp-page="./TwoFactorAuthentication" class="btn btn-primary btn-sm">Done</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
