@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
    Layout = KTTheme.GetView("Auth.cshtml");
}

<div class="row">
	<div>
	<!--begin::Heading-->
	<div class="text-center mb-4">
			
		<img alt="Logo" src="~/img/default-dark.png" class="h-60px h-lg-75px mb-4"/>
			
		<!--begin::Title-->
		<h1 class="text-gray-900 fw-bolder">
			@ViewData["Title"]
		</h1>
		<!--end::Title-->
		<p>
			Your password has been reset. Please <a asp-page="./Login">click here to log in</a>.
		</p>
	</div>
	<!--begin::Heading-->
	</div>
</div>
