@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Account Confirmation";
    Layout = KTTheme.GetView("Auth.cshtml");
}

<div class="row">
	<div>
		<!--begin::Heading-->
		<div class="text-center mb-4">
		
			<img alt="Logo" src="~/img/default-dark.png" class="h-60px h-lg-75px mb-4"/>
		
			<!--begin::Title-->
			<h1 class="text-gray-900 fw-bolder">
				@ViewData["Title"]
			</h1>
			<!--end::Title-->
		</div>
		<!--begin::Heading-->
		
		<p class="text-center">
			Please check your email to confirm your account. or <a href="@Model.EmailConfirmationUrl">Click here</a>
		</p>
		
	</div>
</div>