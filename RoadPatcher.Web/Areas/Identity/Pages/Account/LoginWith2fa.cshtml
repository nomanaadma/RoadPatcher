@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
    Layout = KTTheme.GetView("Auth.cshtml");
}

<div class="row">
    <div>
        <section>
            <div class="text-center mb-11">
                <img alt="Logo" src="~/img/default-dark.png" class="h-60px h-lg-75px mb-4" />
                <h1 class="text-gray-900 fw-bolder">@ViewData["Title"]</h1>
                <div class="text-gray-600 mt-2">Enter the code from your authenticator app.</div>
            </div>

            <form method="post" class="mb-7" asp-page-handler="LoginWith2fa">
                <input asp-for="RememberMe" type="hidden" />
                <input asp-for="ReturnUrl" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-5">
                    <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" placeholder="123456" />
                    <label asp-for="Input.TwoFactorCode"></label>
                    <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
                </div>

                <div class="checkbox mb-5">
                    <label asp-for="Input.RememberMachine" class="form-label text-gray-600">
                        <input asp-for="Input.RememberMachine" class="form-check-input" />
                        @Html.DisplayNameFor(m => m.Input.RememberMachine)
                    </label>
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary">Verify code</button>
            </form>

            <div class="separator separator-content my-7">
                <span class="w-300px text-gray-500 fw-semibold fs-7">Or use a recovery code</span>
            </div>

            <form method="post" asp-page-handler="RecoveryCode">
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="form-floating mb-5">
                    <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Recovery code" />
                    <label asp-for="Input.RecoveryCode"></label>
                    <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
                </div>

                <button type="submit" class="w-100 btn btn-light-primary">Use recovery code</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
