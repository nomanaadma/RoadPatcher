@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RoadPatcher.Application.Data
@using RoadPatcher.Application.Entities
@using RoadPatcher.Helpers
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@{
	
	var user = await UserManager.GetUserAsync(User);
	
	var userData = await DbContext.UserData.FirstOrDefaultAsync(x => x.UserId == user!.Id);

	var profileImage = ProfileHelper.GetProfileImage(userData?.Image);
	
}
<!--begin::Navbar-->
<div class="app-navbar flex-shrink-0">
	<!--begin::User menu-->
	<div class="app-navbar-item ms-1 ms-md-4" id="kt_header_user_menu_toggle">
		
		<div class="d-flex align-items-stretch flex-shrink-0 gap-0">

			@if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
			{
				<div class="d-flex align-items-stretch ms-1 ms-lg-2">
					<div class="d-flex align-items-center">
						<a data-bs-toggle="tooltip" title="Admin Panel" data-bs-placement="bottom" class="btn btn-icon btn-active-light-warning w-30px h-30px w-md-40px h-md-40px" asp-area="Admin" asp-controller="Users" asp-action="Index" target="_blank">
							<i class="las la-cogs fz-24"></i>
						</a>
					</div>
				</div>
			}
			
			<div class="d-flex align-items-stretch ms-1 ms-lg-2">
				<div class="d-flex align-items-center">
					<a data-bs-toggle="tooltip" title="Search" data-bs-placement="bottom" class="btn btn-icon btn-active-light-warning w-30px h-30px w-md-40px h-md-40px search_posts" href="javascript:void(0)">
						<i class="las la-search fz-24 rotate-270"></i>	
					</a>
				</div>
			</div>
			
			<div class="d-flex align-items-stretch ms-1 ms-lg-2">
				<div class="d-flex align-items-center">
					<a data-bs-toggle="tooltip" title="Create Post" data-bs-placement="bottom" class="btn btn-icon btn-active-light-warning w-30px h-30px w-md-40px h-md-40px" asp-controller="Posts" asp-action="Create" asp-area="">
						<i class="las la-plus-square fz-24"></i>
					</a>
				</div>
			</div>
			
			<div class="d-flex align-items-stretch ms-1 ms-lg-2">
				<div class="d-flex align-items-center position-relative">
					<a data-bs-toggle="tooltip" title="Notifications" data-bs-placement="bottom" class="btn btn-icon btn-active-light-warning w-30px h-30px w-md-40px h-md-40px" href="/Notifications">
						<i class="las la-bell fz-24"></i>
						<span id="unreadNotificationCount" class="badge bg-danger position-absolute translate-middle text-white">0</span>
					</a>
				</div>
			</div>
			
			<div class="d-flex align-items-stretch ms-1 ms-lg-2">
				<div class="d-flex align-items-center">
					<a data-bs-toggle="tooltip" title="Setting" data-bs-placement="bottom" class="btn btn-icon btn-active-light-warning w-30px h-30px w-md-40px h-md-40px" asp-controller="Settings" asp-action="Index" asp-area="">
						<i class="las la-cog fz-24"></i>
					</a>
				</div>
			</div>
			
			<a asp-controller="Settings" asp-action="EditProfile" asp-area="" data-bs-toggle="tooltip" title="@user!.Email" class="ms-3 symbol user-profile-nav" data-img="@profileImage" data-id="@user.Id" aria-label="User Profile" data-lat="@userData?.Latitude" data-lng="@userData?.Longitude">
				<img src="@profileImage" alt="User Profile" class="rounded-circle border border-3" >
			</a>
			
			<div class="d-flex align-items-stretch ms-1 ms-lg-2">
				<div class="d-flex align-items-center">
					<form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
						<button data-bs-toggle="tooltip" title="Logout" data-bs-placement="bottom" type="submit" class="btn btn-icon btn-active-light-warning w-30px h-30px w-md-40px h-md-40px">
							<i class="las la-sign-out-alt fz-24 rotate-180"></i>
						</button>
					</form>
				</div>
			</div>

			
		</div>
		
	</div>
	<!--end::User menu-->
	<!--end::Header menu toggle-->
</div>
<!--end::Navbar-->