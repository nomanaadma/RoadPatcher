@using RoadPatcher.Application.Data
@using RoadPatcher.Application.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RoadPatcher.Helpers
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@{

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var path = Context.Request.Path.Value ?? "";


    var isSettingsController = controller == "Settings";

    var isEditProfile =
        isSettingsController &&
        action == "EditProfile";

    var isChangePassword =
        isSettingsController &&
        action == "ChangePassword";

    var isIdentity =
        path.Contains("/Account/Manage/");

    var showAccountMenu =
        isSettingsController ||
        isIdentity;

    var showPostMenu =
        action == "Manage" ||
        action == "Create" ||
        action == "Pending" ||
        action == "InProcess" ||
        action == "Completed" ||
        action == "Favourited" ||
        action == "Donated";


    var user = await UserManager.GetUserAsync(User);
	
	var userData = await DbContext.UserData.FirstOrDefaultAsync(x => x.UserId == user!.Id);

	var profileImage = UserHelper.GetProfileImage(userData?.Image);

	var creatorBadgeSvg = ContributionHelper.GetBadgeSvg(userData?.Badge);


}

<!--begin::sidebar menu-->
<div class="app-sidebar-menu overflow-hidden flex-column-fluid">
    <!--begin::Menu wrapper-->
    <div id="kt_app_sidebar_menu_wrapper" class="app-sidebar-wrapper">
        <!--begin::Scroll wrapper-->
        <div id="kt_app_sidebar_menu_scroll" class="scroll-y my-5 mx-3" data-kt-scroll="true" data-kt-scroll-activate="true" data-kt-scroll-height="auto" data-kt-scroll-dependencies="#kt_app_sidebar_logo, #kt_app_sidebar_footer" data-kt-scroll-wrappers="#kt_app_sidebar_menu" data-kt-scroll-offset="5px" data-kt-scroll-save-state="true">
            
            
            
            <!--begin::Menu-->
            <div class="menu menu-column menu-rounded menu-sub-indention fw-semibold fs-6" id="#kt_app_sidebar_menu" data-kt-menu="true" data-kt-menu-expand="false">
                

                <div class="menu-item"><!--begin:Menu content--><div class="menu-content menu-content-profile"><span class="menu-heading fw-bold text-uppercase fs-7">
                  
                    <a asp-controller="Settings" asp-action="Index" asp-area="" title="@user!.Email" class="symbol user-profile-nav" data-img="@profileImage" data-id="@user.Id" data-lat="@userData?.Latitude" data-lng="@userData?.Longitude">
                        <img src="@profileImage" alt="User Profile" class="rounded-circle border border-3" >
                        @Html.Raw(creatorBadgeSvg)
                        <span class="ms-4">@user!.Email</span>
                    </a>
                    
                </span></div><!--end:Menu content--></div>

                <div class="menu-item">
                    <!--begin:Menu link-->
                    <a class="menu-link @(controller == "Admin" ? "active" : "")" href="/Admin">
                        <span class="menu-icon"><i class="las la-tachometer-alt fz-24"></i></span>
                        <span class="menu-title">Dashboard</span>
                    </a>
                </div>

                <div class="menu-item">
                    <!--begin:Menu link-->
                    <a class="menu-link @(controller == "Statistics" ? "active" : "")" asp-area="Admin" asp-controller="Statistics" asp-action="Index">
                        <span class="menu-icon"><i class="las la-chart-area fz-24"></i></span>
                        <span class="menu-title">Statistics</span>
                    </a>
                </div>

                <div class="menu-item position-relative">
                    <!--begin:Menu link-->
                    <a class="menu-link @(controller == "Notifications" ? "active" : "")" href="/Notifications">
                        <span class="menu-icon"><i class="las la-bell fz-24"></i></span>
                        <span class="menu-title">Notifications</span>
                        <span id="unreadNotificationCount" class="badge bg-danger position-absolute translate-middle text-white">0</span>
                    </a>
                </div>


                <!-- Non-Admin Menu -->
                <div data-kt-menu-trigger="click" class="menu-item menu-accordion @(showAccountMenu ? "show" : "")">
                    <span class="menu-link @(showAccountMenu ? "active" : "")">
                        <span class="menu-icon"><i class="las la-user fz-24"></i></span>
                        <span class="menu-title">Account</span>
                        <span class="menu-arrow"></span>
                    </span><!--end:Menu link--><!--begin:Menu sub-->

                    <div class="menu-sub menu-sub-accordion mt-3">
                        <!--begin:Menu item-->
                        
                        <div class="menu-item">
                            <a asp-controller="Settings" asp-action="EditProfile" asp-area="" class="menu-link @(isEditProfile ? "active" : "")"><i class="la la-user-circle fz-24"></i><span class="menu-title ms-1">Edit Profile</span></a>
                        </div>

                        <div class="menu-item">
                            <a asp-area="" asp-action="ChangePassword" class="menu-link @(isChangePassword ? "active" : "")"><i class="la la-key fz-24"></i><span class="menu-title ms-1">Change Password</span></a>
                        </div>

                        <div class="menu-item">
                            <a asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication" class="menu-link @(isIdentity ? "active" : "")"><i class="la la-unlock-alt fz-24"></i><span class="menu-title ms-1">2FA</span></a>
                        </div>
                        

                    </div>
                    <!--end:Menu sub-->
                </div>

                <!-- Non-Admin Menu -->
                <div data-kt-menu-trigger="click" class="menu-item menu-accordion @(showPostMenu ? "show" : "")">
                    <span class="menu-link @(showPostMenu ? "active" : "")">
                        <span class="menu-icon"><i class="las la-list-alt fz-24"></i></span>
                        <span class="menu-title">Posts</span>
                        <span class="menu-arrow"></span>
                    </span><!--end:Menu link--><!--begin:Menu sub-->

                    <div class="menu-sub menu-sub-accordion mt-3">
                        <!--begin:Menu item-->
                        
                        <div class="menu-item">
                            <a asp-controller="Posts" asp-action="Manage" asp-area=""class="menu-link @(action == "Manage" ? "active" : "")"><i class="la la-list-alt fz-24"></i><span class="menu-title ms-1">List</span></a>
                        </div>

                        <div class="menu-item">
                            <a asp-controller="Posts" asp-action="Create" asp-area="" class="menu-link @(action == "Create" ? "active" : "")"><i class="la la-plus-square fz-24"></i><span class="menu-title ms-1">Create</span></a>
                        </div>

                        <div class="menu-item">
                            <a href="javascript:void(0)" class="search_posts menu-link"><i class="la la-search fz-24"></i><span class="menu-title ms-1">Search</span></a>
                        </div>

                        <div class="menu-item">
                            <a asp-controller="Posts" asp-action="Pending" asp-area="" class="menu-link @(action == "Pending" ? "active" : "")"><i class="la la-road fz-24"></i><span class="menu-title ms-1">Pending</span></a>
                        </div>

                        <div class="menu-item">
                            <a asp-controller="Posts" asp-action="InProcess" asp-area="" class="menu-link @(action == "InProcess" ? "active" : "")"><i class="la la-truck-loading fz-24"></i><span class="menu-title ms-1">In Process</span></a>
                        </div>

                        <div class="menu-item">
                            <a asp-controller="Posts" asp-action="Completed" asp-area="" class="menu-link @(action == "Completed" ? "active" : "")"><i class="la la-check-circle fz-24"></i><span class="menu-title ms-1">Completed</span></a>
                        </div>

                        <div class="menu-item">
                            <a asp-controller="Posts" asp-action="Favourited" asp-area="" class="menu-link @(action == "Favourited" ? "active" : "")"><i class="la la-bookmark fz-24"></i><span class="menu-title ms-1">Favourited</span></a>
                        </div>

                        <div class="menu-item">
                            <a asp-controller="Posts" asp-action="Donated" asp-area="" class="menu-link @(action == "Donated" ? "active" : "")"><i class="la la-donate fz-24"></i><span class="menu-title ms-1">Donated</span></a>
                        </div>

                    </div>
                    <!--end:Menu sub-->
                </div>

                <div class="menu-item">
                    <!--begin:Menu link-->
                    <a class="menu-link @(controller == "Leaderboard" ? "active" : "")" asp-area="" asp-controller="Leaderboard" asp-action="Index">
                        <span class="menu-icon"><i class="las la-trophy fz-24"></i></span>
                        <span class="menu-title">Leader Board</span>
                    </a>
                </div>

                <div class="menu-item">
                    <!--begin:Menu link-->
                    <a class="menu-link @(controller == "Users" ? "active" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                        <span class="menu-icon"><i class="las la-users fz-24"></i></span>
                        <span class="menu-title">Users</span>
                    </a>
                </div>

                <div class="menu-item">
                    <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
                        <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
                    </form>
                    
                    <a class="menu-link logout-link" href="javascript:void(0);">
                        <span class="menu-icon"><i class="las la-sign-out-alt fz-24"></i></span>
                        <span class="menu-title">Logout</span>
                    </a>
                </div>
				
            </div>
            <!--end::Menu-->
        </div>
        <!--end::Scroll wrapper-->
    </div>
    <!--end::Menu wrapper-->
</div>
<!--end::sidebar menu-->