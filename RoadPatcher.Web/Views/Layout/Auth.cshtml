@{ 
	// Master layout
	Layout = "~/Views/Layout/Master.cshtml"; 

	// Layout options
	KTTheme.AddHtmlClass("body", "app-blank");
}

<!--begin::Root-->
<div class="d-flex flex-column flex-root auth_page" id="kt_app_root">
	<!--begin::Wrapper-->
	<div class="d-flex flex-column flex-lg-row flex-column-fluid">
		<!--begin::Body-->
		<div class="d-flex flex-column flex-lg-row-fluid w-lg-50 px-5 px-md-15 order-2 order-lg-1">
			<!--begin::Form-->
			<div class="d-flex flex-center flex-column flex-lg-row-fluid">
				<!--begin::Wrapper-->
				<div class="w-lg-500px p-10 bg-white rounded-4">
					<!--begin::Page-->
					@RenderBody()
					<!--end::Page-->
				</div>
				<!--end::Wrapper-->
			</div>
			<!--end::Form-->       
		</div>
		<!--end::Body-->
	</div>
	<!--end::Wrapper-->
</div>
<!--end::Root-->

@await RenderSectionAsync("Scripts", required: false)
