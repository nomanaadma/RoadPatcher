@using RoadPatcher.Helpers
@model RoadPatcher.Models.PostViewModel

@{
    ViewData["Title"] = "Edit Post";
    var uploadFolderUrl = Url.Content("~/uploads/posts/");
    ViewData["IsEdit"] = true;
	var canComplete = User.IsAdmin() || User.IsSuperAdmin();
}

<partial name="_PostForm" model="Model" />

@section Scripts {
	
	<script>
		let position = null;
		let zoom = 5;
		@if (!string.IsNullOrWhiteSpace(Model?.GoogleAddress))
		{
			<text>
				position = {
					lat: @Model.Latitude,
					lng: @Model.Longitude
				}
				zoom = 16; 
			</text>
		}
	</script>
	<partial name="_AddressScript" />
	<script src="https://releases.transloadit.com/uppy/v3.13.1/uppy.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
	<script src="~/js/post-form.js"></script>
	<partial name="_ValidationScriptsPartial" />
	<script>

		function preloadMedia(targetUppy, id, name) {

			fetch("@uploadFolderUrl" + '/' + name)
				.then(r => r.blob())
				.then(blob => {

					targetUppy.addFile({
						id: id,
						name: name,
						type: blob.type,
						data: blob,
						size: blob.size,
						meta: {
							uploaded: true,
							id: id
						}
					});

				});
		}
		
		document.addEventListener('DOMContentLoaded', function () {
			
			
			@foreach(var media in Model!.MediaFiles)
			{
				@if (media.Id == Model.ImageId)
				{
					<text>
						preloadMedia(uppyImage, @media.Id, "@media.Name");
					</text>
				} 
				else if (media.Id == Model.VideoId)
				{
					<text>
						preloadMedia(uppyVideo, @media.Id, "@media.Name");
					</text>
				}
				else if (canComplete && Model.CompletionImageId.HasValue && media.Id == Model.CompletionImageId.Value)
				{
					<text>
						preloadMedia(uppyCompletion, @media.Id, "@media.Name");
					</text>
				}
				else
				{
					<text>
				        preloadMedia(uppyImages, @media.Id, "@media.Name");
				    </text>	
				}
			    
			}
			
		});
	</script>
	
}
