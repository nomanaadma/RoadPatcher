@model RoadPatcher.Models.PostViewModel
@{
    ViewData["Title"] = "Edit Post";
    var uploadFolderUrl = Url.Content("~/uploads/posts/");
    ViewData["IsEdit"] = true;
}

<partial name="_PostForm" model="Model" />

@section Scripts {
	
	<script src="https://releases.transloadit.com/uppy/v3.13.1/uppy.min.js"></script>
	<script src="~/js/post-form.js"></script>
	<partial name="_ValidationScriptsPartial" />
	<script>

		function preloadMedia(targetUppy, id, name) {

			fetch("@uploadFolderUrl" + '/' + name)
				.then(r => r.blob())
				.then(blob => {

					targetUppy.addFile({
						id: id,
						name: name,
						type: blob.type,
						data: blob,
						size: blob.size,
						meta: {
							uploaded: true,
							id: id
						}
					});

				});
		}
		
		document.addEventListener('DOMContentLoaded', function () {
			
			preloadMedia(uppyImage, @Model.Image!.Id, "@Model.Image.Name");
			
			preloadMedia(uppyVideo, @Model.Video!.Id, "@Model.Video.Name");

			@foreach(var media in Model.MediaFiles)
			{
			    <text>
			        preloadMedia(uppyImages, @media.Id, "@media.Name");
			    </text>
			}
			
		});
	</script>
	
}
