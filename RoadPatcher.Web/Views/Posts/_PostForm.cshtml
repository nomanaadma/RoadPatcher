@using RoadPatcher.Helpers
@model RoadPatcher.Models.PostViewModel
@using System.Security.Claims
@using RoadPatcher.Application.Entities

@{
	var isEdit = ViewData["IsEdit"] as bool? ?? false;

	var pageType = isEdit ? "Edit" : "Create";
	var canComplete = User.IsInRole("Admin") || User.IsSuperAdmin();

	var submitTitle = "Create";

	if(isEdit) {

		submitTitle = "Edit";

		var userId = User.FindFirstValue(ClaimTypes.NameIdentifier)!;

		if(userId == Model.ReviewerId && Model.ReviewStatus != ApprovalStatus.Approved) {
			submitTitle += " and Approve";
		}
		
	}

	submitTitle += " Post";
}

<link href="https://releases.transloadit.com/uppy/v3.13.1/uppy.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />

<div class="row g-5 justify-content-center">
	<div class="col-lg-7 mb-10">
		<form asp-action="@pageType" method="post">
		    
			<div class="card create-post">
				<div class="card-header card-header-secondary">
					<h1 class="fs-2 m-0">@pageType Post</h1>
				</div>
				<div class="card-body">

					<div class="d-flex flex-column mb-8 fv-row">
						<label asp-for="Description" class="fs-6-5 fw-semibold mb-2"></label>
						<div id="editor">
							@if (isEdit)
							{
								@Model.Description	
							}
						</div>
						<textarea asp-for="Description" id="Description" class="form-control form-control-solid" hidden></textarea>
						<span asp-validation-for="Description" class="text-danger"></span>
					</div>

					<hr class="mb-5 mt-10">
					
					<div class="media_guideline">
						<h2>Media Guideline</h2>
						<div class="media_guideline_content">
							<p class="text-gray-700 fs-7 mt-3">
								Please follow these guidelines when uploading media. Clear images and videos help reviewers assess damage quickly and approve repairs.
							</p>
							<ul class="text-gray-700 lh-22">
								<li>Images must be clear, in-focus, and well-lit showing the damaged area close-up.</li>
								<li>Ensure lighting conditions are optimal. Avoid heavy shadows, glare, or overexposure from direct sunlight so the pothole or damage is clearly visible and its depth and extent can be accurately assessed.</li>
								<li>Videos should be steady, clearly show the issue, and be short — focus on the problem area.</li>
								<li>Avoid obstructions; include context so location and extent of damage are visible.</li>
								<li>If privacy is a concern, blur faces or personal information before uploading.</li>
							</ul>

							<hr />
							<h5 class="mt-3">Demo Media</h5>
							<div class="row demo-media">
								<div class="col-md-6 mb-3">
									<img src="/img/image_instruction.jpg" alt="Demo image" class="img-fluid rounded demo-image" />
								</div>
								<div class="col-md-6 mb-3 d-flex flex-column align-items-stretch">
									<video class="demo-instruction-video mb-2" controls src="/img/video_instruction.mp4" poster="/img/image_instruction.jpg" style="width:100%;height:auto;">Your browser does not support the video tag.</video>
								</div>
							</div>
						</div>
						<span class="badge badge-light-primary media_guideline_toggle">Show</span>
					</div>

					<hr class="mb-10 mt-5">



					<div class="row">
						<div class="col main-image-col">
							<label asp-for="ImageId" class="fs-6-5 fw-semibold mb-2">Image</label>
							<input type="text" class="hidden-physical" asp-for="ImageId"/>
							<span asp-validation-for="ImageId" class="text-danger"></span>
							<div id="uppy-image"></div>							
						</div>

						
						
						<div class="col">
							<label asp-for="VideoId" class="fs-6-5 fw-semibold mb-2">Video</label>
							<input type="text" class="hidden-physical" asp-for="VideoId"/>
							<span asp-validation-for="VideoId" class="text-danger"></span>
							<div id="uppy-video"></div>
						</div>
					</div>

					<div class="row g-5 mb-5 mt-1 distance-fields">
						<div class="col-md-6 fv-row">
							<label asp-for="CameraHeightFromGround" class="fs-6-5 fw-semibold mb-2"></label>
							<div class="text-gray-600 fs-7 mb-2 address-disclaimer">
								<i class="las la-info-circle"></i> Distance from the ground/user's feet to the camera.
							</div>
							<input asp-for="CameraHeightFromGround" type="number" min="0.01" step="0.01" class="form-control form-control-solid" />
							<span asp-validation-for="CameraHeightFromGround" class="text-danger"></span>
						</div>
						<div class="col-md-6 fv-row">
							<label asp-for="CameraToCenterDistance" class="fs-6-5 fw-semibold mb-2"></label>
							<div class="text-gray-600 fs-7 mb-2 address-disclaimer">
								<i class="las la-info-circle"></i> Distance from the camera to the center point of the image.
							</div>
							<input asp-for="CameraToCenterDistance" type="number" min="0.01" step="0.01" class="form-control form-control-solid" />
							<span asp-validation-for="CameraToCenterDistance" class="text-danger"></span>
						</div>
					</div>

					<div class="d-flex flex-column mb-5 fv-row">

						@if(isEdit && User.IsAdminOrSuperAdmin()) {

							<div class="mb-5 fv-row">
								<label for="confidenceThreshold" class="fs-6-5 fw-semibold mb-2">Confidence Threshold</label>
								<input id="confidenceThreshold" name="confidenceThreshold" type="range" min="0.1" max="1.0" step="0.05" value="0.25" class="form-range" />
								<div class="d-flex justify-content-between align-items-center mt-2">
									<small class="text-gray-600">Adjust pothole detection confidence</small>
									<strong class="confidence-threshold-value">0.25</strong>
								</div>
							</div>

							<div class="d-flex flex-column gap-3 mb-5">
								<button type="button" id="runInferenceBtn" class="btn btn-sm btn-dark">Run Inference</button>
								<div id="inferenceResults" class="border rounded p-4 bg-light d-none mt-2"></div>
							</div>
							
							<input type="hidden" asp-for="InferenceData" id="InferenceData" />
							<input type="hidden" asp-for="InferenceImageName" id="InferenceImageName" />

							<label asp-for="Cost" class="fs-6-5 fw-semibold mb-2"></label>
							<input asp-for="Cost" class="form-control form-control-solid number-separator post-cost-field"/>
							<span asp-validation-for="Cost" class="text-danger"></span>
						}
					</div>
					

					<div class="row mt-8 mb-8 mediafiles-row">
						<label asp-for="MediaFiles" class="fs-6-5 fw-semibold mb-2">Other Images</label>
						<div id="uppy-images"></div>
						@if (isEdit)
						{
							@foreach(var media in Model.MediaFiles)
							{
								<input name="MediaFilesIds[]" class="media-image" type="hidden" value="@media.Id" />
							}
						}
					</div>

					@if (isEdit && canComplete)
					{
						<div class="row mt-8 mb-8">
							<div class="col-12">
								<label asp-for="CompletionImageId" class="fs-6-5 fw-semibold mb-2">Completion Image</label>
								<input type="text" class="hidden-physical" asp-for="CompletionImageId"/>
								<span asp-validation-for="CompletionImageId" class="text-danger"></span>
								<div id="uppy-completion"></div>
							</div>
						</div>
					}

					<partial name="_AddressFromFields" model="Model" />

				</div>
				<div class="card-footer">
					<button type="submit" id="submitBtn" class="btn btn-sm btn-primary">@submitTitle</button>
					@if (isEdit && canComplete && Model.Status == PostStatus.InProcess)
					{
						<button type="submit" name="submitAction" value="Complete" class="ms-2 btn btn-sm btn-success">Complete</button>
					}
					<button onclick="history.back()" type="button" class="ms-2 btn btn-sm btn-secondary">Discard</button>
				</div>
			</div>
		</form>
	</div>

</div>


