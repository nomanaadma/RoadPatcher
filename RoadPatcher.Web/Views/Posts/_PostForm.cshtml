@using RoadPatcher.Helpers
@model RoadPatcher.Models.PostViewModel
@using System.Security.Claims
@using RoadPatcher.Application.Entities

@{
	var isEdit = ViewData["IsEdit"] as bool? ?? false;

	var pageType = isEdit ? "Edit" : "Create";
	var canComplete = User.IsInRole("Admin") || User.IsSuperAdmin();

	var submitTitle = "Create";

	if(isEdit) {

		submitTitle = "Edit";

		var userId = User.FindFirstValue(ClaimTypes.NameIdentifier)!;

		if(userId == Model.ReviewerId && Model.ReviewStatus != ApprovalStatus.Approved) {
			submitTitle += " and Approve";
		}
		
	}

	submitTitle += " Post";
}

<link href="https://releases.transloadit.com/uppy/v3.13.1/uppy.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />

<div class="row g-5 justify-content-center">
	<div class="col-lg-7 mb-10">
		<form asp-action="@pageType" method="post">
		    
			<div class="card create-post">
				<div class="card-header card-header-secondary">
					<h1 class="fs-2 m-0">@pageType Post</h1>
				</div>
				<div class="card-body">

					<div class="d-flex flex-column mb-8 fv-row">
						<label asp-for="Description" class="fs-6-5 fw-semibold mb-2"></label>
						<div id="editor">
							@if (isEdit)
							{
								@Model.Description	
							}
						</div>
						<textarea asp-for="Description" id="Description" class="form-control form-control-solid" hidden></textarea>
						<span asp-validation-for="Description" class="text-danger"></span>
					</div>

					<div class="row">
						<div class="col">
							<label asp-for="ImageId" class="fs-6-5 fw-semibold mb-2">Image</label>
							<input type="text" class="hidden-physical" asp-for="ImageId"/>
							<span asp-validation-for="ImageId" class="text-danger"></span>
							<div id="uppy-image"></div>
						</div>
						<div class="col">
							<label asp-for="VideoId" class="fs-6-5 fw-semibold mb-2">Video</label>
							<input type="text" class="hidden-physical" asp-for="VideoId"/>
							<span asp-validation-for="VideoId" class="text-danger"></span>
							<div id="uppy-video"></div>
						</div>
					</div>

					<div class="row mt-8 mb-8 mediafiles-row">
						<label asp-for="MediaFiles" class="fs-6-5 fw-semibold mb-2">Other Images</label>
						<div id="uppy-images"></div>
						@if (isEdit)
						{
							@foreach(var media in Model.MediaFiles)
							{
								<input name="MediaFilesIds[]" class="media-image" type="hidden" value="@media.Id" />
							}
						}
					</div>

					@if (isEdit && canComplete)
					{
						<div class="row mt-8 mb-8">
							<div class="col-12">
								<label asp-for="CompletionImageId" class="fs-6-5 fw-semibold mb-2">Completion Image</label>
								<input type="text" class="hidden-physical" asp-for="CompletionImageId"/>
								<span asp-validation-for="CompletionImageId" class="text-danger"></span>
								<div id="uppy-completion"></div>
							</div>
						</div>
					}

					<div class="d-flex flex-column mb-5 fv-row">
						<label asp-for="Cost" class="fs-6-5 fw-semibold mb-2"></label>
						<input asp-for="Cost" class="form-control form-control-solid number-separator post-cost-field"/>
						<span asp-validation-for="Cost" class="text-danger"></span>
					</div>
					
					<partial name="_AddressFromFields" model="Model" />

				</div>
				<div class="card-footer">
					<button type="submit" id="submitBtn" class="btn btn-sm btn-primary">@submitTitle</button>
					@if (isEdit && canComplete)
					{
						<button type="submit" name="submitAction" value="Complete" class="ms-2 btn btn-sm btn-success">Complete</button>
					}
					<button onclick="history.back()" type="button" class="ms-2 btn btn-sm btn-secondary">Discard</button>
				</div>
			</div>
		</form>
	</div>

</div>


