@model RoadPatcher.Application.Entities.Post
@using RoadPatcher.Application.Entities
@using System.Security.Claims
@inject IConfiguration Configuration

<partial name="_PostStyles" />
<style>
	.post-link-btn, .post-link-btn * {
		pointer-events: none;
		background-color: #dcdcdc !important;
		color: #7c7c7c !important;
	}
	.review-panel {
		background-color: #f8f9fa;
		border-radius: 0.5rem;
		padding: 1.5rem;
	}
	.review-textarea {
		resize: vertical;
		min-height: 120px;
	}
</style>

@{
	var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
	var userRoles = User.FindAll(ClaimTypes.Role);
	var isReviewer = Model.ReviewerId == userId;
	var isSuperAdmin = userRoles.Any(r => r.Value == "SuperAdmin");
	var isPostOwner = Model.UserId == userId;
	var canReview = (isReviewer || isSuperAdmin) && Model.ReviewStatus == ApprovalStatus.InReview;
	var canEdit = (isPostOwner && Model.ReviewStatus == ApprovalStatus.ChangesRequested) || isReviewer || isSuperAdmin;
}

<div class="row">
	<div class="col-12 px-3">
        
		<partial name="_Post" model="Model"/>
		
		<!-- Edit Button (visible to post owner if ChangesRequested, or to reviewer/superadmin) -->
		@if (canEdit)
		{
			<div class="mt-3 mb-2">
				@if ((isPostOwner && Model.ReviewStatus == ApprovalStatus.ChangesRequested) || isReviewer || isSuperAdmin)
				{
					<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">
						<i class="las la-edit"></i> Edit Post
					</a>
				}
			</div>
		}
		
		<div class="my-2">&nbsp;</div>
	</div>
	
	<!-- Review Panel (visible only to reviewer when status == InReview) -->
	@if (canReview)
	{
		<div class="col-12 px-3 mt-4">
			<div class="review-panel">
				<h5 class="mb-4"><i class="las la-tasks"></i> Post Review</h5>
				
				<form id="reviewForm" method="post">
					<!-- Request Changes Comment -->
					<div class="mb-3">
						<label for="reviewComment" class="form-label">Review Comment</label>
						<textarea id="reviewComment" name="comment" class="form-control review-textarea" placeholder="Add your review comment here..."></textarea>
						<small class="text-muted">This comment will be sent to the post owner as a notification</small>
					</div>
					
					<!-- Review Buttons -->
					<div class="d-flex gap-2">
						<button type="submit" name="action" value="RequestChanges" class="btn btn-warning btn-sm">
							<i class="las la-comments"></i> Request Changes
						</button>
						<button type="submit" name="action" value="Approve" class="btn btn-success btn-sm">
							<i class="las la-check-circle"></i> Approve
						</button>
						<button type="submit" name="action" value="Reject" class="btn btn-danger btn-sm">
							<i class="las la-times-circle"></i> Reject
						</button>
					</div>
				</form>
			</div>
		</div>
	}
</div>

<script>
	document.getElementById('reviewForm')?.addEventListener('submit', async function(e) {
		e.preventDefault();
		
		const action = e.submitter.value;
		const comment = document.getElementById('reviewComment').value;
		const postId = @Model.Id;
		
		try {
			const response = await fetch(`/Posts/Review/${postId}`, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify({
					action: action,
					comment: comment
				})
			});
			
			if (response.ok) {
				toastr.success(`Post ${action.toLowerCase()} successfully!`);
				setTimeout(() => location.reload(), 1500);
			} else {
				const error = await response.json();
				toastr.error(error.message || 'An error occurred');
			}
		} catch (error) {
			toastr.error('Error submitting review');
			console.error(error);
		}
	});
</script>

@section Scripts {
	<script>
		window.stripePublishableKey = '@Configuration["Stripe:PublishableKey"]';
	</script>
	<partial name="_PostScripts" />
}