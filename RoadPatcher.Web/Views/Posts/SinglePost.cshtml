@model RoadPatcher.Application.Entities.Post
@using RoadPatcher.Application.Entities
@using System.Security.Claims
@using RoadPatcher.Helpers
@inject IConfiguration Configuration

<partial name="_PostStyles" />
<style>
	.post-link-btn, .post-link-btn * {
		pointer-events: none;
		background-color: #dcdcdc !important;
		color: #7c7c7c !important;
	}
</style>

@{

	ViewData["IsSingle"] = true;

	var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);

}

<div class="row">
	<div class="col-12 px-3">
		<partial name="_Post" model="Model"/>
		<div class="my-2">&nbsp;</div>
	</div>
</div>

@section Scripts {
	<script>
		window.stripePublishableKey = '@Configuration["Stripe:PublishableKey"]';
	</script>
	<partial name="_PostScripts" />
	@if (TempData["Success"] != null)
	{
		<script>
			toastr.success("@TempData["Success"]");
		</script>
	}

	@if (TempData["FormErrors"] != null)
	{
		var errors = TempData["FormErrors"]!.ToString()!.Split("||");
		foreach (var err in errors)
		{
			<script>
				toastr.error("@err");
			</script>
		}
	}
}