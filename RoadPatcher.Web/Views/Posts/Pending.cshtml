@using System.Security.Claims
@using RoadPatcher.Application.Data
@using RoadPatcher.Application.Entities
@using RoadPatcher.Helpers
@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<RoadPatcher.Application.Entities.Post>
@inject ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Pending";
	var uploadFolderUrl = Url.Content("~/uploads/posts/");
	var userId = User.FindFirstValue(ClaimTypes.NameIdentifier)!;
	
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<div class="row">
	<div class="col-12 px-3">
		
		@foreach (var post in Model)
		{
			var userData = post.User!.UserData;
			var profileImage = ProfileHelper.GetProfileImage(userData?.Image);
			
			var mainImage = post.MediaFiles
				.FirstOrDefault(m => m.Id == post.ImageId)!;
			
			var mainVideo = post.MediaFiles
				.FirstOrDefault(m => m.Id == post.VideoId)!;
			
			var otherMedia = post.MediaFiles
				.Where(m => m.Id != post.ImageId && m.Id != post.VideoId)
				.ToList();
			
			List<Media> mediaFiles =
			[
				mainImage,
				mainVideo,
				..otherMedia
			];
			
			var userFullName = userData!.FirstName + ' ' + userData.LastName;
			
			var raisedPercentage = PostHelper.GetRaisedPercentage(post.Cost, post.Raised);
			var remainingAmount = PostHelper.GetRemaining(post.Cost, post.Raised);
			var progressClass = PostHelper.GetProgressClass(raisedPercentage);
			var tooltipBoxPercentage = PostHelper.GetTooltipBoxPercentage(raisedPercentage);

			var isLiked = DbContext.Likes.Any(l => l.PostId == post.Id && l.UserId == userId);

			<div class="card mx-auto road-post">
	
				<div class="d-flex">
	
					<div class="col post-media d-flex flex-column justify-content-center position-relative bg-black">
						
						<button class="zoomBtn btn btn-light position-absolute">
							<i class="las la-search-plus fz-20"></i>
						</button>

						<div class="swiper postSlider">
							<div class="swiper-wrapper">

								@foreach (var media in mediaFiles)
								{
									<a href="@uploadFolderUrl@media.Name" data-fslightbox="@post.Id" class="d-none">@media.Name</a>
									<div class="swiper-slide d-flex justify-content-center align-items-center bg-black"
									     data-id="@post.Id"
									     style="height:500px;">

										@if (media.Id == post.VideoId) // if it's main video
										{
											<video controls class="w-100" style="max-height: 500px;" preload="metadata">
												<source src="@uploadFolderUrl@media.Name" type="video/mp4">
												Your browser does not support the video tag.
											</video>
										}
										else // if images
										{
											<img src="@uploadFolderUrl@media.Name" class="img-fluid" style="max-height: 500px; object-fit:contain;" alt="@media.Name">
										}
									</div>
								}

							</div>

							<!-- Arrows -->
							<div class="swiper-button-next"></div>
							<div class="swiper-button-prev"></div>
							<div class="swiper-pagination"></div>

						</div>

					</div>

	
					<div class="col post-details">
	
						<div class="card-header border-0 d-flex align-items-center bg-white p-4">
							<img src="@profileImage" class="rounded-circle me-2" style="width: 40px; height: 40px;" alt="@userFullName Avatar">
							<div class="flex-grow-1 time-location-i">
								<h6 class="mb-0">@userFullName</h6>
								<span><i class="las la-clock position-relative"></i> @post.CreatedAt.ToPrettyFormat() </span>
							</div>
						</div>
						
						@if (!string.IsNullOrEmpty(post.Description))
						{
							<div class="text-center mb-4 fs-5">@Html.Raw(post.Description)</div>
						}
	
						<div class="container p-6 pt-2 pb-2">
							
							<div class="d-flex justify-content-center mb-4">
								
								<table class="shadow-sm location-table">
									<tr>
										<td colspan="2" style="border-top: 0;"><i class="las la-map-marker position-relative"></i> @post.Address</td>
									</tr>
									<tr>
										<td colspan="2"><i class="las la-map-marked-alt position-relative"></i> @post.GoogleAddress <button type="button" class="btn btn-sm btn-light-info small-rounded-btn view_on_map">View on Map</button></td>
									</tr>
									<tr>
										<td class="border-0"><span><i class="las la-map-pin position-relative"></i> Latitude: @post.Latitude</span></td>
										<td class="border-0"><span><i class="las la-map-pin position-relative"></i> Longitude: @post.Longitude</span></td>
									</tr>
								</table>
							</div>

							<div class="card shadow-sm border-0 rounded-3">
								<div class="card-body p-4">

									<div class="row text-center">

										<div class="col-6 border-end">
											<small class="fw-bold">Goal</small>
											<h2 class="fw-bolder mb-0 fz-20">Rs. @post.Cost.ToPkr()</h2>
										</div>

										<div class="col-6">
											<small class="text-orange fw-bold">Remaining</small>
											<h2 class="fw-bolder mb-0 fz-20">Rs. @remainingAmount.ToPkr()</h2>
										</div>
									</div>

									<hr class="text-muted opacity-25">

									<div class="donation-progress position-relative my-5">
										<!-- Progress -->
										<div class="progress">
											<div class="progress-bar bg-@progressClass" style="width: @raisedPercentage%;"></div>
										</div>

										<div class="progress-circle position-absolute translate-middle bg-@progressClass"
										     style="left: @raisedPercentage%;"></div>
										
										<div class="detached-arrow tooltip-arrow position-absolute border-@progressClass" style="left: @raisedPercentage%;"></div>

										<!-- Always Visible Tooltip -->
										<div class="custom-tooltip position-absolute translate-middle-x tooltip-loading"
										     style="left: @tooltipBoxPercentage%;">
											<div class="tooltip-content bg-light-@progressClass border-@progressClass rounded fs-6 fw-bold">
												
												<div class="d-flex justify-content-center">
													<div class="wrapper-grid">
														<div class="cube">
															<div class="face face-front">L</div>
															<div class="face face-back"></div>
															<div class="face face-right"></div>
															<div class="face face-left"></div>
															<div class="face face-top"></div>
															<div class="face face-bottom"></div>
														</div>

														<div class="cube">
															<div class="face face-front">O</div>
															<div class="face face-back"></div>
															<div class="face face-right"></div>
															<div class="face face-left"></div>
															<div class="face face-top"></div>
															<div class="face face-bottom"></div>
														</div>

														<div class="cube">
															<div class="face face-front">A</div>
															<div class="face face-back"></div>
															<div class="face face-right"></div>
															<div class="face face-left"></div>
															<div class="face face-top"></div>
															<div class="face face-bottom"></div>
														</div>

														<div class="cube">
															<div class="face face-front">D</div>
															<div class="face face-back"></div>
															<div class="face face-right"></div>
															<div class="face face-left"></div>
															<div class="face face-top"></div>
															<div class="face face-bottom"></div>
														</div>

														<div class="cube">
															<div class="face face-front">I</div>
															<div class="face face-back"></div>
															<div class="face face-right"></div>
															<div class="face face-left"></div>
															<div class="face face-top"></div>
															<div class="face face-bottom"></div>
														</div>

														<div class="cube">
															<div class="face face-front">N</div>
															<div class="face face-back"></div>
															<div class="face face-right"></div>
															<div class="face face-left"></div>
															<div class="face face-top"></div>
															<div class="face face-bottom"></div>
														</div>

														<div class="cube">
															<div class="face face-front">G</div>
															<div class="face face-back"></div>
															<div class="face face-right"></div>
															<div class="face face-left"></div>
															<div class="face face-top"></div>
															<div class="face face-bottom"></div>
														</div>
													</div>
												</div>

												<div class="d-flex tooltip-content-inner">
													<div>
														<img src="~/img/worker.png" style="width: 150px" alt="worker">
													</div>
													<div class="text-center tooltip-box py-2 position-relative">

														<div class="row m-0">
															<div class="col-6 border-end py-2 px-0 achieved-box">
																<span class="fw-bold fs-4">@raisedPercentage%</span> <br>
																<span class="fs-4 ">Achieved</span>
															</div>
															<div class="col-6 p-2">
																<span class="fw-bold fs-4">Rs. @post.Raised.ToPkr() </span> <br>
																<span class="fs-4 ">Raised</span>
															</div>
															<div class="col-12 p-0">
																<div class="mt-1"> Donated by <span class="fw-bold text-@progressClass fs-4">@post.PeopleDonated</span> people</div>
															</div>
														</div>

													</div>

												</div>
												
											</div>
										</div>
									</div>

									<div class="donation-btn text-center">
										<button class="btn btn-lg text-uppercase fw-bolder">
											<i class="las la-hand-holding-usd"></i> Donate <i class="las la-heart"></i>
										</button>
									</div>

								</div>
							</div>

						</div>
	
						<div class="card-footer border-0 bg-white pt-2 pb-0 post-footer">
	
							<div class="d-flex justify-content-around text-muted py-1 pb-4">
	
								<a href="javascript:void(0)" 
								   data-post-id="@post.Id" 
								   class="btn btn-link text-decoration-none d-flex border-light-success shadow-hover text-hover-success like-btn @(isLiked ? "bg-light-success" : "") ">
									<i class="las la-thumbs-up like-icon p-0"></i> 
									<span class="ps-1 like-text"> @(isLiked ? "Liked" : "Like")</span>
									<span class="badge badge-light-success ms-2 like-count">@post.Likes</span>
								</a>
								
								<a href="#" class="btn btn-link text-decoration-none d-flex border-light-primary shadow-hover text-hover-primary">
									<i class="las la-comments"></i> Discussion <span class="badge badge-light-primary ms-2">@post.Discussions</span>
								</a>
								
								<a href="#" class="btn btn-link text-decoration-none d-flex border-light-warning shadow-hover text-hover-warning">
									<i class="las la-share"></i> Share <span class="badge badge-light-warning ms-2">@post.Shares</span>
								</a>
	
								<a href="#" class="btn btn-link text-decoration-none d-flex border-light-danger shadow-hover text-hover-danger">
									<i class="las la-bookmark"></i> Favourite <span class="badge badge-light-danger ms-2">@post.Favourites</span>
								</a>
	
							</div>
	
						</div>
	
					</div>
	
				</div>
	
			</div>

			<hr class="my-10" />
			
		}
		
	</div>
	
	@Html.PagedListPager(
		Model,
		page => Url.Action("Pending", new { page }),
		new PagedListRenderOptions
		{
			MaximumPageNumbersToDisplay = 5,
			LinkToPreviousPageFormat = "<i class=\"las la-angle-left\"></i>",
			LinkToNextPageFormat = "<i class=\"las la-angle-right\"></i>",
			LiElementClasses = ["page-item"],
			PageClasses = ["page-link"],
			UlElementClasses = ["pagination", "justify-content-center"]
		}
	)

	<br>
	<br>
	<br>
	
</div>

@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
	<script src="~/js/fslightbox.js"></script>
	<script src="~/js/post.js"></script>
}

















