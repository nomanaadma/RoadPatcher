@model RoadPatcher.Application.Entities.Post
@using System.Security.Claims
@using System.Linq
@using RoadPatcher.Application.Data
@using RoadPatcher.Application.Entities
@using RoadPatcher.Helpers

@inject ApplicationDbContext DbContext
@{
	var userId = User.FindFirstValue(ClaimTypes.NameIdentifier)!;
	var uploadFolderUrl = Url.Content("~/uploads/posts/");
	var userData = Model.User!.UserData;
	var profileImage = UserHelper.GetProfileImage(userData?.Image);
	var creatorBadge = userData?.Badge;
	var creatorBadgeSvg = ContributionHelper.GetBadgeSvg(creatorBadge);

	var completionImage = Model.MediaFiles
		.FirstOrDefault(m => m.Id == Model.CompletionImageId);

	var mainImage = Model.MediaFiles
		.FirstOrDefault(m => m.Id == Model.ImageId)!;
			
	var mainVideo = Model.MediaFiles
		.FirstOrDefault(m => m.Id == Model.VideoId)!;
			
	var otherMedia = Model.MediaFiles
		.Where(m => m.Id != Model.ImageId && m.Id != Model.VideoId)
		.ToList();
			
	List<Media> mediaFiles =
	[
		mainImage,
		mainVideo,
		..otherMedia
	];

	if(completionImage != null) {
		mediaFiles.Insert(0, completionImage);
	}
			
	var userFullName = UserHelper.GetFullName(userData!);
			
	var raisedPercentage = PostHelper.GetRaisedPercentage(Model.Cost, Model.Raised);
	var remainingAmount = PostHelper.GetRemaining(Model.Cost, Model.Raised);
	var progressClass = PostHelper.GetProgressClass(raisedPercentage);
	var tooltipBoxPercentage = PostHelper.GetTooltipBoxPercentage(raisedPercentage);

	if (raisedPercentage % 1 == 0)
		raisedPercentage = (int)raisedPercentage;

	var isLiked = DbContext.Likes.Any(l => l.PostId == Model.Id && l.UserId == userId);
	var isFavourited = DbContext.Favourites.Any(l => l.PostId == Model.Id && l.UserId == userId);
	var isDiscussed = DbContext.Comments.Any(l => l.PostId == Model.Id && l.UserId == userId);
	var isShared = DbContext.Shares.Any(l => l.PostId == Model.Id && l.UserId == userId);
	var isSubscribed = DbContext.PostNotificationSubscriptions.Any(s => s.PostId == Model.Id && s.UserId == userId);


	var isSingle = ViewData["IsSingle"] as bool? ?? false;


	var canEdit = false;

	if(
		User.IsSuperAdmin()	|| 
		(userId == Model.UserId && Model.ReviewStatus == ApprovalStatus.ChangesRequested) ||
		(userId == Model.ReviewerId && Model.ReviewStatus == ApprovalStatus.InReview)
	) {
		canEdit = true;
	}


	var canReview = false;

	if(
		User.IsSuperAdmin()	|| 
		(userId == Model.ReviewerId && Model.ReviewStatus == ApprovalStatus.InReview)
	) {
		canReview = true;
	}
	
}
<div class="card mx-auto road-post">
	
	<div class="d-flex">
		<div class="col post-media d-flex flex-column justify-content-center position-relative bg-black">

			<button class="zoomBtn btn position-absolute">
				<i class="las la-search-plus fz-20"></i>
			</button>

			<div class="swiper postSlider">
				<div class="swiper-wrapper">

					@foreach (var media in mediaFiles)
					{
						<a href="@uploadFolderUrl@media.Name" data-fslightbox="@Model.Id" class="d-none">@media.Name</a>
						<div class="swiper-slide d-flex justify-content-center align-items-center bg-black"
						     data-id="@Model.Id"
						     style="height:500px;">

							@if (media.Id == Model.VideoId) // if it's main video
							{
								<video controls class="w-100" style="max-height: 500px;" preload="metadata">
									<source src="@uploadFolderUrl@media.Name" type="video/mp4">
									Your browser does not support the video tag.
								</video>
							}
							else // if images
							{
								<img src="@uploadFolderUrl@media.Name" class="img-fluid" style="max-height: 500px; object-fit:contain;" alt="@media.Name" loading="lazy">
								<div class="swiper-lazy-preloader"></div>
							}
						</div>
					}

				</div>

				<!-- Arrows -->
				<div class="swiper-button-next">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="5 4 15 15" fill="none">
						<path d="M8.91016 19.9201L15.4302 13.4001C16.2002 12.6301 16.2002 11.3701 15.4302 10.6001L8.91016 4.08008" stroke="#eee" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
						<path d="M8.91016 19.9201L15.4302 13.4001C16.2002 12.6301 16.2002 11.3701 15.4302 10.6001L8.91016 4.08008" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</div>
				<div class="swiper-button-prev">
					<?xml version="1.0" encoding="utf-8"?>

					<svg viewBox="5 4 15 15" fill="none"
					     xmlns="http://www.w3.org/2000/svg">
						<path
							d="M8.91016 19.9201L15.4302 13.4001C16.2002 12.6301 16.2002 11.3701 15.4302 10.6001L8.91016 4.08008"
							stroke="#eee"
							stroke-width="4"
							stroke-linecap="round"
							stroke-linejoin="round" transform="scale(-1,1) translate(-24,0)"/>
						<path
							d="M8.91016 19.9201L15.4302 13.4001C16.2002 12.6301 16.2002 11.3701 15.4302 10.6001L8.91016 4.08008"
							stroke="#000"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round" transform="scale(-1,1) translate(-24,0)"/>

					</svg>

				</div>
				<div class="swiper-pagination"></div>

			</div>

		</div>


		<div class="col post-details">

			<div class="card-header border-0 d-flex align-items-center bg-white p-4 flex-nowrap">
				<img src="@profileImage" class="post_profile_image rounded-circle me-2" alt="@userFullName Avatar">
				<div class="flex-grow-1 time-location-i">
					<h6 class="mb-0 d-flex align-items-center gap-2">
						<span>@userFullName</span>
						@if (!string.IsNullOrWhiteSpace(creatorBadgeSvg))
						{
							<span class="d-inline-flex align-items-center" title="@creatorBadge Contributor">@Html.Raw(creatorBadgeSvg)</span>
						}
					</h6>
					<span><i class="las la-clock position-relative"></i> @Model.CreatedAt.ToPrettyFormat() • @Model.CreatedAt.ToAgo() </span>
				</div>
				
				<a asp-action="SinglePost" asp-route-id="@Model.Id" data-bs-toggle="tooltip" title="Open Post" data-bs-placement="bottom" class="btn btn-dark rounded-20 post-link-btn">
					<i class="las la-link text-white"></i> <span>#@Model.Id</span>
					<i class="las notify-icon ms-2 @(isSubscribed ? "la-bell text-info" : "la-bell-slash text-muted")" 
					   data-post-id="@Model.Id"
					   data-bs-toggle="tooltip"
					   title="Toggle Notifications"
					   data-bs-placement="bottom"
					   style="cursor:pointer;">
					</i>
				</a>

				@if(Model.ReviewStatus == ApprovalStatus.InReview) {
					<span class="btn btn-light-primary rounded-20 disabled-anchor ms-2">In Review</span>
				}

				@if(Model.ReviewStatus == ApprovalStatus.ChangesRequested) {
					<span class="btn btn-light-warning rounded-20 disabled-anchor ms-2">Changes Requested</span>
				}

				@if(Model.ReviewStatus == ApprovalStatus.Rejected) {
					<span class="btn btn-light-danger rounded-20 disabled-anchor ms-2">Rejected</span>
				}

				@if(canEdit) {
					<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light ms-2 rounded-20">Edit</a>
				}

			</div>

			@if (!string.IsNullOrEmpty(Model.Description))
			{
				<div class="text-center mb-4 fs-5">@Html.Raw(Model.Description)</div>
			}

			<div class="container p-6 pt-2 pb-2">

				<div class="d-flex justify-content-center mb-4 location-table shadow-sm">

					<table>
						<tr>
							<td colspan="2" style="border-top: 0;">
								<div class="d-flex align-items-center">
									<i class="las la-map-marker position-relative me-2"></i> <span>@Model.Address</span>
								</div>
							</td>
						</tr>
						<tr>
							<td colspan="2">
								<div class="d-flex align-items-center">
									<i class="las la-map-marked-alt position-relative me-2"></i>
									<span>
										@Model.GoogleAddress <button type="button" data-lat="@Model.Latitude" data-lng="@Model.Longitude" class="btn btn-sm btn-light-info small-rounded-btn view_on_map">View on Map</button>
									</span>
								</div>
							</td>
						</tr>
						<tr>
							<td class="border-0"><span><i class="las la-map-pin position-relative me-1"></i> Latitude: @Model.Latitude</span></td>
							<td class="border-0"><span><i class="las la-map-pin position-relative me-1"></i> Longitude: @Model.Longitude</span></td>
						</tr>
					</table>
				</div>

				<div class="card border-0 rounded-3">
					<div class="card-body p-4 pt-2">

						<div class="post-costing row text-center">
							
							@if (remainingAmount == 0 || Model.ReviewStatus != ApprovalStatus.Approved)
							{
								<div class="col-12">
									<small class="fw-bold text-success">Goal</small>
									<h2 class="fw-bolder mb-0 fz-20">@Model.Cost.ToPkr()</h2>
								</div>
							}
							else
							{
								<div class="col-6 border-end">
									<small class="fw-bold">Goal</small>
									<h2 class="fw-bolder mb-0 fz-20">@Model.Cost.ToPkr()</h2>
								</div>

								<div class="col-6">
									<small class="text-orange fw-bold">Remaining</small>
									<h2 class="fw-bolder mb-0 fz-20 remaining_amount">@remainingAmount.ToPkr()</h2>
								</div>	
							}

						</div>

						@if(Model.ReviewStatus == ApprovalStatus.Approved) {

						<hr class="text-muted opacity-25">

						<div class="donation-progress position-relative my-5">
							<!-- Progress -->
							<div class="progress">
								<div class="progress-bar bg-@progressClass" style="width: @raisedPercentage%;"></div>
							</div>

							<div class="progress-circle position-absolute translate-middle bg-@progressClass"
							     style="left: @raisedPercentage%;"></div>

							<div class="detached-arrow tooltip-arrow position-absolute border-@progressClass" style="left: @raisedPercentage%;"></div>

							<!-- Always Visible Tooltip -->
							<div class="custom-tooltip position-absolute translate-middle-x tooltip-loading"
							     style="left: @tooltipBoxPercentage%;">
								<div class="tooltip-content bg-light-@progressClass border-@progressClass rounded fs-6 fw-bold">

									<div class="d-flex justify-content-center">
										<div class="wrapper-grid">
											<div class="cube">
												<div class="face face-front">L</div>
												<div class="face face-back"></div>
												<div class="face face-right"></div>
												<div class="face face-left"></div>
												<div class="face face-top"></div>
												<div class="face face-bottom"></div>
											</div>

											<div class="cube">
												<div class="face face-front">O</div>
												<div class="face face-back"></div>
												<div class="face face-right"></div>
												<div class="face face-left"></div>
												<div class="face face-top"></div>
												<div class="face face-bottom"></div>
											</div>

											<div class="cube">
												<div class="face face-front">A</div>
												<div class="face face-back"></div>
												<div class="face face-right"></div>
												<div class="face face-left"></div>
												<div class="face face-top"></div>
												<div class="face face-bottom"></div>
											</div>

											<div class="cube">
												<div class="face face-front">D</div>
												<div class="face face-back"></div>
												<div class="face face-right"></div>
												<div class="face face-left"></div>
												<div class="face face-top"></div>
												<div class="face face-bottom"></div>
											</div>

											<div class="cube">
												<div class="face face-front">I</div>
												<div class="face face-back"></div>
												<div class="face face-right"></div>
												<div class="face face-left"></div>
												<div class="face face-top"></div>
												<div class="face face-bottom"></div>
											</div>

											<div class="cube">
												<div class="face face-front">N</div>
												<div class="face face-back"></div>
												<div class="face face-right"></div>
												<div class="face face-left"></div>
												<div class="face face-top"></div>
												<div class="face face-bottom"></div>
											</div>

											<div class="cube">
												<div class="face face-front">G</div>
												<div class="face face-back"></div>
												<div class="face face-right"></div>
												<div class="face face-left"></div>
												<div class="face face-top"></div>
												<div class="face face-bottom"></div>
											</div>
										</div>
									</div>

									<div class="d-flex tooltip-content-inner">
										<div>
											<img src="~/img/worker.png" style="width: 150px" alt="worker">
										</div>
										<div class="text-center tooltip-box py-2 position-relative">

											<div class="row m-0">
												<div class="col-6 border-end py-2 px-0 achieved-box">
													<span class="fw-bold fs-4"><span class="raised_percentage">@raisedPercentage</span>%</span> <br>
													<span class="fs-4 ">Achieved</span>
												</div>
												<div class="col-6 p-2">
													<span class="fw-bold fs-4 raised_amount">@Model.Raised.ToPkr()</span> <br>
													<span class="fs-4 ">Raised</span>
												</div>
												<div class="col-12 p-0">
													<div class="mt-1"> Donated by <span class="people_donated_count fw-bold text-@progressClass fs-4">@Model.PeopleDonated</span> people</div>
												</div>
											</div>

										</div>

									</div>

								</div>
							</div>
						</div>
						<div class="mark-btn null"></div>
						
						@if (Model.Status == PostStatus.Pending)
						{
							<div class="mark-btn donation-btn text-center">
								<button class="btn btn-lg text-uppercase fw-bolder donation-btn-button" data-post-id="@Model.Id">
									<i class="las la-hand-holding-usd"></i> Donate <i class="las la-heart"></i>
								</button>	
							</div>
						}
						
						}

					</div>
				</div>

			</div>

			@if(Model.ReviewStatus == ApprovalStatus.Approved) {

			<div class="card-footer border-0 bg-white pt-2 pb-0 post-footer">

				<div class="d-flex justify-content-around text-muted py-1 pb-4">

					<a href="javascript:void(0)"
					   data-post-id="@Model.Id"
					   class="btn btn-link text-decoration-none d-flex border-light-success shadow-hover text-hover-success like-btn @(isLiked ? "bg-light-success" : "") ">
						<i class="las la-thumbs-up like-icon p-0"></i>
						<span class="ps-1 like-text"> @(isLiked ? "Liked" : "Like")</span>
						<span class="badge badge-light-success ms-2 like-count">@Model.Likes</span>
					</a>

					<a href="javascript:void(0)"
					   data-post-id="@Model.Id"
					   class="btn btn-link text-decoration-none d-flex border-light-primary shadow-hover text-hover-primary discussion-btn @(isDiscussed ? "bg-light-primary" : "")">
						<i class="las la-comments discussion-icon"></i>
						<span class="ps-1">Discussion</span>
						<span class="badge badge-light-primary ms-2 discussion-count">@Model.Discussions</span>
					</a>

					<a href="javascript:void(0)"
					   data-post-id="@Model.Id"
					   class="btn btn-link text-decoration-none d-flex border-light-warning shadow-hover text-hover-warning share-btn @(isShared ? "bg-light-warning" : "")">
						<i class="las la-share"></i> Share
						<span class="badge badge-light-warning ms-2 share-count">@Model.Shares</span>
					</a>

					<a href="javascript:void(0)"
					   data-post-id="@Model.Id"
					   class="btn btn-link text-decoration-none d-flex border-light-danger shadow-hover text-hover-danger favourite-btn @(isFavourited ? "bg-light-danger" : "") ">
						<i class="las la-bookmark favourite-icon p-0"></i>
						<span class="ps-1 favourite-text"> @(isFavourited ? "Favourited" : "Favourite")</span>
						<span class="badge badge-light-danger ms-2 favourite-count">@Model.Favourites</span>
					</a>

				</div>

			</div>
			
			}
			

			@if (canReview)
			{ 
				<!-- Review Panel (visible only to reviewer when status == InReview) -->
				<div>
					<div class="review-panel bg-white">
						<h5 class="mb-4"><i class="las la-tasks"></i> Post Review</h5>
						
						<form id="reviewForm" method="post">
							<!-- Request Changes Comment -->
							<div class="mb-3">
								<label for="reviewComment" class="form-label">Review Comment</label>
								<textarea id="reviewComment" name="comment" class="form-control review-textarea" placeholder="Add your review comment here..."></textarea>
							</div>
							
							<!-- Review Buttons -->
							<div class="d-flex gap-2">
								<button type="submit" name="action" value="RequestChanges" class="btn btn-warning btn-sm">
									Request Changes
								</button>
								<button type="submit" name="action" value="Approve" class="btn btn-success btn-sm">
									Approve
								</button>
								<button type="submit" name="action" value="Reject" class="btn btn-danger btn-sm">
									Reject
								</button>
							</div>
						</form>
					</div>
				</div>
			}

		</div>

	</div>

</div>

@if (canReview && isSingle)
{
<script>
	document.getElementById('reviewForm')?.addEventListener('submit', async function(e) {
		e.preventDefault();
		
		const action = e.submitter.value;
		const comment = document.getElementById('reviewComment').value;
		const postId = @Model.Id;
		
		try {
			const response = await fetch(`/Posts/Review/${postId}`, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify({
					action: action,
					comment: comment
				})
			});
			
			if (response.ok) {
				toastr.success(`Post ${action.toLowerCase()} successfully!`);
				setTimeout(() => location.reload(), 1500);
			} else {
				const error = await response.json();
				toastr.error(error.message || 'An error occurred');
			}
		} catch (error) {
			toastr.error('Error submitting review');
			console.error(error);
		}
	});
</script>	
}