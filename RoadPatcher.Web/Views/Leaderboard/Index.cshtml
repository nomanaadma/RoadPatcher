@model RoadPatcher.Models.LeaderboardPageViewModel
@using RoadPatcher.Helpers
@using Microsoft.AspNetCore.Html

@{
	ViewData["Title"] = "Top Contributors";

	static IHtmlContent EmptyState(string message, int colspan)
	{
		return new HtmlString($"<tr><td colspan=\"{colspan}\" class=\"text-center text-muted py-5\">{message}</td></tr>");
	}
}

<div class="container-fluid px-0 leaderboard-page">
	<div class="card mb-6">
		<div class="card-body p-6">
			<div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
				<div>
					<h1 class="mb-1">Top Contributors</h1>
					<p class="text-muted mb-0">Recognizing the most active donors and recent supporters.</p>

					<br>
					<div class="row g-4">
						<div class="col-4 badge-legend-item d-flex gap-2 align-items-center">
							@Html.Raw(ContributionHelper.GetBadgeSvg("bronze", 50))
							<div>
								<div class="fw-bold">Bronze</div>
								<div class="text-muted small">Donations totaling Rs. 1,000 or more.</div>
							</div>
						</div>

						<div class="col-4 badge-legend-item d-flex gap-2 align-items-center">
							@Html.Raw(ContributionHelper.GetBadgeSvg("silver", 50))
							<div>
								<div class="fw-bold">Silver</div>
								<div class="text-muted small">Donations totaling Rs. 5,000 or more.</div>
							</div>
						</div>

						<div class="col-4 badge-legend-item d-flex gap-2 align-items-center">
							@Html.Raw(ContributionHelper.GetBadgeSvg("gold", 50))
							<div>
								<div class="fw-bold">Gold</div>
								<div class="text-muted small">Donations totaling Rs. 10,000 or more.</div>
							</div>
						</div>

						<div class="col-4 badge-legend-item d-flex gap-2 align-items-center">
							@Html.Raw(ContributionHelper.GetBadgeSvg("platinum", 50))
							<div>
								<div class="fw-bold">Platinum</div>
								<div class="text-muted small">Donations totaling Rs. 25,000 or more.</div>
							</div>
						</div>

						<div class="col-4 badge-legend-item d-flex gap-2 align-items-center">
							@Html.Raw(ContributionHelper.GetBadgeSvg("emerald", 50))
							<div>
								<div class="fw-bold">Emerald</div>
								<div class="text-muted small">Donations totaling Rs. 50,000 or more.</div>
							</div>
						</div>

						<div class="col-4 badge-legend-item d-flex gap-2 align-items-center">
							@Html.Raw(ContributionHelper.GetBadgeSvg("diamond", 50))
							<div>
								<div class="fw-bold">Diamond</div>
								<div class="text-muted small">Donations totaling Rs. 100,000 or more.</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row g-6">
		<div class="col-4">
			<div class="card shadow-sm">
				<div class="card-header border-0 pt-5 pb-0">
					<h3 class="card-title align-items-start flex-column">
						<span class="card-label fw-bold fs-3 mb-1">Top Bronze Contributors @Html.Raw(ContributionHelper.GetBadgeSvg("bronze"))</span>
					</h3>
				</div>
				<div class="card-body py-3 pt-0">
					<div class="table-responsive">
						<table class="table align-middle table-row-dashed gy-5 mb-0">
							<thead>
								<tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
									<th>#</th>
									<th>User Name</th>
									<th>Amount</th>
								</tr>
							</thead>
							<tbody>
								@if (Model.BronzeContributors.Any())
								{
									foreach (var row in Model.BronzeContributors)
									{
										<tr class="fw-semibold">
											<td>@row.Rank</td>
											<td>@row.UserName</td>
											<td>@row.Amount.ToPkr()</td>
										</tr>
									}
								}
								else
								{
									@EmptyState("No bronze contributors yet.", 3)
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>

		<div class="col-4">
			<div class="card shadow-sm">
				<div class="card-header border-0 pt-5 pb-0">
					<h3 class="card-title align-items-start flex-column">
