			</div>
		</div>
		
		<div class="col-12 mb-10">
			<div class="card shadow-sm">
				<div class="card-header border-0 pt-5 pb-0">
					<h3 class="card-title align-items-start flex-column">
						<span class="card-label fw-bold fs-3 mb-1">Recent Donations</span>
					</h3>
				</div>
				<div class="card-body py-3 pt-0">
					<div class="table-responsive">
						<table class="table align-middle table-row-dashed gy-5 mb-0">
							<thead>
								<tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
									<th>#</th>
									<th>User Name</th>
									<th>Amount</th>
									<th>Date of Donation</th>
									<th>Post ID</th>
								</tr>
							</thead>
							<tbody>
								@if (Model.RecentDonations.Any())
								{
									foreach (var row in Model.RecentDonations)
									{
										<tr class="fw-semibold">
											<td>@row.Rank</td>
											<td>@row.UserName @Html.Raw(ContributionHelper.GetBadgeSvg(row.Badge))</td>
											<td>@row.Amount.ToPkr()</td>
											<td>@row.DonationDate.ToPrettyFormat()</td>
											<td class="notification-td"><a href="/Posts/@row.PostId" >#@row.PostId</a></td>
										</tr>
									}
								}
								else
								{
									@EmptyState("No donations yet.", 5)
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
