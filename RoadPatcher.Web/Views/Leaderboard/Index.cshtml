@model List<RoadPatcher.Services.LeaderboardEntry>

@{
    ViewData["Title"] = "Leaderboard";
}

<h2>Leaderboard</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>User</th>
            <th>Points</th>
        </tr>
    </thead>
    <tbody>
    @for (int i = 0; i < Model.Count; i++)
    {
        var entry = Model[i];
        <tr>
            <td>@(i + 1)</td>
            <td>@entry.UserName</td>
            <td>@entry.Points</td>
        </tr>
    }
    </tbody>
</table>
