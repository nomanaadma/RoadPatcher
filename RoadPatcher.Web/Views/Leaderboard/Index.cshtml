@model RoadPatcher.Models.LeaderboardPageViewModel
@using RoadPatcher.Helpers
@using Microsoft.AspNetCore.Html

@{
	ViewData["Title"] = "Top Contributors";

	static IHtmlContent EmptyState(string message, int colspan)
	{
		return new HtmlString($"<tr><td colspan=\"{colspan}\" class=\"text-center text-muted py-5\">{message}</td></tr>");
	}
}

<div class="container-fluid px-0 leaderboard-page">
	<div class="card mb-6">
		<div class="card-body p-6">
			<div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
				<div>
					<h1 class="mb-1">Top Contributors</h1>
					<p class="text-muted mb-0">Recognizing the most active donors and recent supporters.</p>
				</div>
			</div>
		</div>
	</div>

	<div class="row g-6">
		<div class="col-4">
			<div class="card shadow-sm">
				<div class="card-header border-0 pt-5">
					<h3 class="card-title align-items-start flex-column">
						<span class="card-label fw-bold fs-3 mb-1">Top Gold Contributors</span>
					</h3>
				</div>
				<div class="card-body py-3">
					<div class="table-responsive">
						<table class="table align-middle table-row-dashed gy-5 mb-0">
							<thead>
								<tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
									<th>#</th>
									<th>User Name</th>
									<th>Amount</th>
								</tr>
							</thead>
							<tbody>
								@if (Model.GoldContributors.Any())
								{
									foreach (var row in Model.GoldContributors)
									{
										<tr>
											<td>@row.Rank</td>
											<td>@row.UserName</td>
											<td>@row.Amount.ToPkr()</td>
										</tr>
									}
								}
								else
								{
									@EmptyState("No gold contributors yet.", 3)
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>

		<div class="col-4">
			<div class="card shadow-sm">
				<div class="card-header border-0 pt-5">
					<h3 class="card-title align-items-start flex-column">
						<span class="card-label fw-bold fs-3 mb-1">Top Silver Contributors</span>
					</h3>
				</div>
				<div class="card-body py-3">
					<div class="table-responsive">
						<table class="table align-middle table-row-dashed gy-5 mb-0">
							<thead>
								<tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
									<th>#</th>
									<th>User Name</th>
									<th>Amount</th>
								</tr>
							</thead>
							<tbody>
								@if (Model.SilverContributors.Any())
								{
									foreach (var row in Model.SilverContributors)
									{
										<tr>
											<td>@row.Rank</td>
											<td>@row.UserName</td>
											<td>@row.Amount.ToPkr()</td>
										</tr>
									}
								}
								else
								{
									@EmptyState("No silver contributors yet.", 3)
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>

		<div class="col-4">
			<div class="card shadow-sm">
				<div class="card-header border-0 pt-5">
					<h3 class="card-title align-items-start flex-column">
						<span class="card-label fw-bold fs-3 mb-1">Top Bronze Contributors</span>
					</h3>
				</div>
				<div class="card-body py-3">
					<div class="table-responsive">
						<table class="table align-middle table-row-dashed gy-5 mb-0">
							<thead>
								<tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
									<th>#</th>
									<th>User Name</th>
									<th>Amount</th>
								</tr>
							</thead>
							<tbody>
								@if (Model.BronzeContributors.Any())
								{
									foreach (var row in Model.BronzeContributors)
									{
										<tr>
											<td>@row.Rank</td>
											<td>@row.UserName</td>
											<td>@row.Amount.ToPkr()</td>
										</tr>
									}
								}
								else
								{
									@EmptyState("No bronze contributors yet.", 3)
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>

		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-header border-0 pt-5">
					<h3 class="card-title align-items-start flex-column">
						<span class="card-label fw-bold fs-3 mb-1">Recent Donations</span>
					</h3>
				</div>
				<div class="card-body py-3">
					<div class="table-responsive">
						<table class="table align-middle table-row-dashed gy-5 mb-0">
							<thead>
								<tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
									<th>#</th>
									<th>User Name</th>
									<th>Amount</th>
									<th>Date of Donation</th>
									<th>Post ID</th>
								</tr>
							</thead>
							<tbody>
								@if (Model.RecentDonations.Any())
								{
									foreach (var row in Model.RecentDonations)
									{
										<tr>
											<td>@row.Rank</td>
											<td>@row.UserName</td>
											<td>@row.Amount.ToPkr()</td>
											<td>@row.DonationDate.ToPrettyFormat()</td>
											<td>#@row.PostId</td>
										</tr>
									}
								}
								else
								{
									@EmptyState("No donations yet.", 5)
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>