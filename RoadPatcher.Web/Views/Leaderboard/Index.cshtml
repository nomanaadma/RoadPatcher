@model List<RoadPatcher.Services.LeaderboardEntry>
@using RoadPatcher.Helpers

@{
    ViewData["Title"] = "Leaderboard";
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">
                <i class="las la-trophy" style="color: #FFD700;"></i>
                Top Contributors Leaderboard
            </h1>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Contributor</th>
                            <th style="text-align: right;">Total Points</th>
                            <th style="text-align: center;">Badge</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var entry = Model[i];
                            var (cssClass, icon, color) = BadgeHelper.GetBadgeStyle(entry.Badge);
                            var rank = i + 1;
                            
                            <tr>
                                <td>
                                    @if (rank == 1)
                                    {
                                        <span class="badge bg-warning text-dark">🥇</span>
                                    }
                                    else if (rank == 2)
                                    {
                                        <span class="badge bg-secondary">🥈</span>
                                    }
                                    else if (rank == 3)
                                    {
                                        <span class="badge bg-danger">🥉</span>
                                    }
                                    else
                                    {
                                        <span>@rank</span>
                                    }
                                </td>
                                <td>
                                    <strong>@entry.UserName</strong>
                                </td>
                                <td style="text-align: right;">
                                    <span style="font-weight: bold; font-size: 16px;">@entry.Points</span>
                                </td>
                                <td style="text-align: center;">
                                    @if (!string.IsNullOrEmpty(entry.Badge))
                                    {
                                        <div class="@cssClass">
                                            <span class="badge-icon">@icon</span>
                                            <span>@entry.Badge</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <small class="text-muted">—</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    No contributors yet. Be the first to donate and earn badges!
                </div>
            }
        </div>
    </div>
</div>
