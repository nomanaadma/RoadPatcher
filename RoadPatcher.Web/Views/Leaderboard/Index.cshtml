			<div class="card shadow-sm">
				<div class="card-header border-0 pt-5 pb-0">
					<h3 class="card-title align-items-start flex-column">
						<span class="card-label fw-bold fs-3 mb-1">Top Emerald Contributors @Html.Raw(ContributionHelper.GetBadgeSvg("emerald"))</span>
					</h3>
				</div>
				<div class="card-body py-3 pt-0">
					<div class="table-responsive">
						<table class="table align-middle table-row-dashed gy-5 mb-0">
							<thead>
								<tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
									<th>#</th>
									<th>User Name</th>
									<th>Amount</th>
								</tr>
							</thead>
							<tbody>
								@if (Model.EmeraldContributors.Any())
								{
									foreach (var row in Model.EmeraldContributors)
