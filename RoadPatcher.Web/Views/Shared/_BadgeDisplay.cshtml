@using RoadPatcher.Helpers
@model string?

@{
    var (cssClass, icon, color) = BadgeHelper.GetBadgeStyle(Model);
    var description = BadgeHelper.GetBadgeDescription(Model);
}

@if (!string.IsNullOrEmpty(Model) && !string.IsNullOrEmpty(cssClass))
{
    <div class="@cssClass" title="@description">
        <span class="badge-icon">@Html.Raw(icon)</span>
        <span>@Model</span>
    </div>
}
