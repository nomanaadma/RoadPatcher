@{
    ViewData["Title"] = "Home Pages";
}

<div class="row">
    <div class="col-12 px-3">

	    <div class="card mb-3 mx-auto road-post">
		    
		    <div class="d-flex">
			    
			    <div class="col post-media d-flex flex-column justify-content-center bg-black">
				    <img src="~/img/borken-road.jpg" class="w-100" alt="broken road">
			    </div>
			    
			    <div class="col post-details">
				    
				    <div class="card-header border-0 d-flex align-items-center bg-white p-4">
					    <img src="uploads/users/images-1764765621.jpeg" class="rounded-circle me-2" style="width: 40px; height: 40px;" alt="Noman Shoukat Avatar">
					    <div class="flex-grow-1 time-location-i">
						    <h6 class="mb-0">Noman Shoukat</h6>
						    <span><i class="las la-clock position-relative"></i> 17h </span>
						    <span class="ms-1"><i class="las la-map-marker position-relative"></i> Plot R-709 block 17, Federal B Area, Karachi </span>
					    </div>
					    <div>
						    <button class="btn btn-link text-dark p-0 me-2"><i class="las la-ellipsis-h fz-30"></i></button>
					    </div>
				    </div>
				    
				    <div class="container p-6">
					    
					    <p class="text-center mb-4 fs-5">
						    Remember the recent AWS DNS outages caused by race conditions? Someone found another race
						    condition bug in Aurora RDS.
					    </p>
		
					    <div class="card shadow-sm border-0 rounded-3">
						    <div class="card-body p-4">
								
							    <div class="row text-center mt-3">
                            
								    <div class="col-6 border-end">
									    <small class="fw-bold">Goal</small>
									    <h2 class="fw-bolder mb-0 fz-20">Rs. 8,500</h2>
								    </div>
								    
								    <div class="col-6">
									    <small class="text-orange fw-bold">Remaining</small>
									    <h2 class="fw-bolder mb-0 fz-20">Rs. 3,500</h2>
								    </div>
							    </div>

							    <hr class="text-muted opacity-25">
							    
							    <div class="donation-progress position-relative my-5">
								    <!-- Progress -->
								    <div class="progress">
									    <div class="progress-bar bg-primary" style="width: 65%;"></div>
								    </div>
								    
								    <div class="progress-circle position-absolute translate-middle"
								         style="left: 65%;"></div>

								    <!-- Always Visible Tooltip -->
								    <div class="custom-tooltip position-absolute translate-middle-x"
								         style="left: 65%;">
									    <div class="tooltip-arrow border-warning"></div>
									    <div class="tooltip-content bg-light-warning border-warning rounded fs-5 fw-bold">65%</div>
								    </div>
							    </div>
							    
							    <div class="d-flex justify-content-center">
								    <div class="text-center tooltip-box p-2 shadow rounded bg-white border">
										    
									    <div class="row bg-ferozi m-0 rounded">
										    <div class="col-6 border-end py-3">
											    <span class="fw-bold fs-2 text-ferozi">65%</span> <br>
											    <span class="fs-4 ">Achieved</span>
										    </div>
										    <div class="col-6 py-3">
											    <span class="fw-bold fs-2 ">Rs. 5,500 </span> <br>
											    <span class="fs-4 ">Raised</span>
										    </div>
									    </div>
										    
									    <div class="mt-1"> Donated by <span class="fw-bold text-success-dark fs-3">8198</span> people</div>
										    
								    </div>
							    </div>
							    
							    <div class="mt-4 text-center">
								    <button class="btn btn-dark btn-lg">
									    <i class="las la-hand-holding-usd text-white"></i> Make a donation
								    </button>
							    </div>

						    </div>
					    </div>
					    
					    @* *@
					    @* <div class="text-center mb-4"> *@
						   @*  <h1 class="display-2 fw-bold" style="color:#34d1b6;">$150,000</h1> *@
					    @* *@
						   @*  <!-- Progress / Slider --> *@
						   @*  <div class="d-flex justify-content-center mt-3"> *@
							  @*   <input type="range" class="form-range w-75" min="0" max="150000" value="25985" style="accent-color:#137582;"> *@
						   @*  </div> *@
					    @* </div> *@
					    @* *@
					    @* <div class="text-center"> *@
						   @*  <p class="fs-5"> *@
							  @*   We’ve already raised <strong class="fz-20">$25,985</strong> *@
							  @*   &nbsp;&nbsp; <strong class="fz-20">8198</strong> people have donated *@
						   @*  </p> *@
					    @* </div> *@
					    @* *@
					    @* <div class="text-center"> *@
						   @*  <button class="btn btn-success btn-lg"> *@
							  @*   <i class="las la-hand-holding-usd text-white"></i> Make a donation *@
						   @*  </button> *@
					    @* </div> *@

				    </div>
				    
				    <div class="card-footer border-0 bg-white pt-2 pb-0">

					    <div class="d-flex justify-content-around text-muted py-1">

						    <a href="#" class="btn btn-link text-decoration-none d-flex ">
							    <i class="las la-thumbs-up"></i> Like <span class="badge badge-light-success ms-2">10</span>
						    </a>
						    <a href="#" class="btn btn-link text-decoration-none d-flex ">
							    <i class="las la-comments"></i> Discussion <span class="badge badge-light-primary ms-2">10</span>
						    </a>
						    <a href="#" class="btn btn-link text-decoration-none d-flex ">
							    <i class="las la-share"></i> Share <span class="badge badge-light-info ms-2">10</span>
						    </a>

						    <a href="#" class="btn btn-link text-decoration-none d-flex ">
							    <i class="las la-bookmark"></i> Save <span class="badge badge-light-danger ms-2">10</span>
						    </a>

					    </div>

				    </div>
				    
			    </div>
			    
		    </div>

	    </div>
	
	    <br>
	    <br>
	    <br>
	    
    </div>
</div>