@{
    ViewData["Title"] = "Home Pages";
}

<div class="row">
    <div class="col-12 col-md-3 side-col">
        <div class="card">
            <div class="card-body">Left col</div>
        </div>
    </div>
    <div class="col-12 col-md-6 px-3">

        <div class="card mb-3 mx-auto road-post">

            <div class="card-header border-0 d-flex align-items-center bg-white p-4">
                <img src="img/profile.png" class="rounded-circle me-2" style="width: 40px; height: 40px;" alt="Noman Shoukat Avatar">
                <div class="flex-grow-1 time-location-i">
                    <h6 class="mb-0">Noman Shoukat</h6>
                    <span><i class="las la-clock position-relative"></i> 17h </span>
                    <span class="ms-1"><i class="las la-map-marker position-relative"></i> Plot R-709 block 17, Federal B Area, Karachi </span>
                </div>
                <div>
                    <button class="btn btn-link text-dark p-0 me-2"><i class="las la-ellipsis-h fz-30"></i></button>
                </div>
            </div>

            <div class="card-body p-0 py-0">
                
                <p class="card-text mb-4 px-4">
                    Remember the recent AWS DNS outages caused by race conditions? Someone found another race
                    condition bug in Aurora RDS.
                </p>
                
                <img src="~/img/borken-road.jpg" class="w-100" alt="broken road">
                
                <div class="p-4">
                    
                    
                    <div class="container py-5">
                        <div class="text-center mb-4">
                            <h3 class="fw-bold">Support Our Mission:</h3>
                            <h2 class="fw-bold">Building Roads Together</h2>
                        </div>

                        <div class="text-center mb-4">
                            <h1 class="display-2 fw-bold" style="color:#34d1b6;">$150,000</h1>

                            <!-- Progress / Slider -->
                            <div class="d-flex justify-content-center mt-3">
                                <input type="range" class="form-range w-75" min="0" max="150000" value="25985" style="accent-color:#34d1b6;">
                            </div>
                        </div>

                        <div class="text-center">
                            <p class="fs-5">
                                We’ve already raised <strong class="fz-20">$25,985</strong>
                                &nbsp;&nbsp; <strong class="fz-20">8198</strong> people have donated
                            </p>
                        </div>
                        
                        <div class="text-center">
                            <button class="btn btn-success btn-lg">
                                <i class="las la-hand-holding-usd text-white"></i> Make a donation
                            </button>
                        </div>
                        
                    </div>

                </div>
                
            </div>

            <div class="card-footer border-0 bg-white pt-2 pb-0">
                
                <div class="d-flex justify-content-around text-muted py-1">
                    
                    <a href="#" class="btn btn-link text-decoration-none d-flex ">
                        <i class="las la-thumbs-up"></i> Like <span class="badge badge-light-success ms-2">10</span>
                    </a>
                    <a href="#" class="btn btn-link text-decoration-none d-flex ">
                        <i class="las la-comments"></i> Discussion <span class="badge badge-light-primary ms-2">10</span>
                    </a>
                    <a href="#" class="btn btn-link text-decoration-none d-flex ">
                        <i class="las la-share"></i> Share <span class="badge badge-light-info ms-2">10</span>
                    </a>
                    
                    <a href="#" class="btn btn-link text-decoration-none d-flex ">
                        <i class="las la-bookmark"></i> Save <span class="badge badge-light-danger ms-2">10</span>
                    </a>
                    
                </div>
                
            </div>
            
        </div>

        <br>
        <br>
        <br>
        

    </div>
    <div class="col-12 col-md-3 side-col">
        <div class="card">
            <div class="card-body">Right col</div>
        </div>
    </div>
</div>