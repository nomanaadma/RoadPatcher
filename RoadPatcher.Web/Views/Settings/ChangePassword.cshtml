@model RoadPatcher.Models.ChangePasswordViewModel
@{
	ViewData["Title"] = "Change Password";
	var hasPassword = (bool?)ViewBag.HasPassword ?? true;
	var externalProvider = (string?)ViewBag.ExternalProvider ?? "social account";
}

<div class="row g-5 justify-content-center">
	
	<div class="col-lg-7 mb-10">
		
		<a asp-action="Index" class="back-anchor">
			<svg fill="#000000" width="30px" height="30px" viewBox="-11 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg">
				<title>angle-left</title>
				<path d="M7.28 23.28c-0.2 0-0.44-0.080-0.6-0.24l-6.44-6.44c-0.32-0.32-0.32-0.84 0-1.2l6.44-6.44c0.32-0.32 0.84-0.32 1.2 0 0.32 0.32 0.32 0.84 0 1.2l-5.8 5.84 5.84 5.84c0.32 0.32 0.32 0.84 0 1.2-0.16 0.16-0.44 0.24-0.64 0.24z"></path>
			</svg>
		</a>
		
		<form asp-action="ChangePassword" method="post">
			<div class="card">
				<div class="card-header card-header-secondary">
					<h1 class="fs-2 m-0">Change Password</h1></div>
				
				<div class="card-body">
					@if (!hasPassword)
					{
						<div class="alert alert-info mb-5">
							Since you signed in with @externalProvider, you don't have a password. You can set a password here to enable signing in with email and password.
						</div>
					}
	
					<input type="text" name="username" value="@User.Identity?.Name" autocomplete="email" class="d-none">
					
					@if (hasPassword)
					{
						<!--begin::Input group-->
						<div class="d-flex flex-column mb-5 fv-row">
							<!--begin::Label-->
							<label asp-for="OldPassword" class="fs-6-5 fw-semibold mb-2">Current Password</label>
							<!--end::Label-->

							<!--begin::Input-->
							<input asp-for="OldPassword" autocomplete="current-password" class="form-control form-control-solid" />
							<!--end::Input-->
							
							<span asp-validation-for="OldPassword" class="text-danger"></span>
							
						</div>
						<!--end::Input group-->
					}

					<!--begin::Input group-->
					<div class="d-flex flex-column mb-5 fv-row">
						<!--begin::Label-->
						<label asp-for="NewPassword" class="fs-6-5 fw-semibold mb-2">New Password</label>
						<!--end::Label-->

						<!--begin::Input-->
						<input asp-for="NewPassword" autocomplete="new-password" class="form-control form-control-solid" />
						<!--end::Input-->
						
						<span asp-validation-for="NewPassword" class="text-danger"></span>
						
					</div>
					<!--end::Input group-->
					
					<!--begin::Input group-->
					<div class="d-flex flex-column fv-row">
						<!--begin::Label-->
						<label asp-for="ConfirmPassword" class="fs-6-5 fw-semibold mb-2">Confirm Password</label>
						<!--end::Label-->

						<!--begin::Input-->
						<input asp-for="ConfirmPassword" autocomplete="new-password" class="form-control form-control-solid" />
						<!--end::Input-->
						
						<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
						
					</div>
					<!--end::Input group-->

				</div>

				<div class="card-footer">
					<button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
					<a asp-action="Index" class="ms-2 btn btn-sm btn-secondary">Cancel</a>
				</div>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
