@model RoadPatcher.Models.UserDataViewModel

@{
    ViewData["Title"] = "Edit Profile";

    var profileImage = Url.Content("~/img/profile.png");

    if (Model?.ExistingImage is not null)
    {
        profileImage = Url.Content($"~/uploads/users/{Model.ExistingImage}");
    }
}

<div class="row g-5 justify-content-center">
	<div class="col-lg-7 mb-10">

		<a asp-action="Index" class="back-anchor">
			<svg fill="#000000" width="30px" height="30px" viewBox="-11 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg">
				<title>angle-left</title>
				<path d="M7.28 23.28c-0.2 0-0.44-0.080-0.6-0.24l-6.44-6.44c-0.32-0.32-0.32-0.84 0-1.2l6.44-6.44c0.32-0.32 0.84-0.32 1.2 0 0.32 0.32 0.32 0.84 0 1.2l-5.8 5.84 5.84 5.84c0.32 0.32 0.32 0.84 0 1.2-0.16 0.16-0.44 0.24-0.64 0.24z"></path>
			</svg>
		</a>
		
		<form asp-action="EditProfile" enctype="multipart/form-data" method="post" id="EditProfile">
			<div class="card">
				<div class="card-header">
					<h1 class="fs-2 m-0">Account Details</h1></div>

				<div class="card-body">

					<!--begin::Input group-->
					<div class="row mb-10">

						<!--begin::Col-->
						<div class="text-center">
							<!--begin::Image input-->
							<div class="image-input image-input-outline" data-kt-image-input="true"
							     style="background-image: url('@profileImage')">

								<!--begin::Preview existing avatar-->
								<div class="image-input-wrapper w-125px h-125px"
								     style="background-image: url('@profileImage')"></div>
								<!--end::Preview existing avatar-->

								<!--begin::Label-->
								<label asp-for="ImageUpload" class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow"
								       data-kt-image-input-action="change" data-bs-toggle="tooltip" title="Change Profile">
									<i class="las la-pen"></i>
									<!--begin::Inputs-->
									<input asp-for="ImageUpload" type="file" accept=".png, .jpg, .jpeg"/>
									<input type="hidden" name="avatar_remove"/>
									<!--end::Inputs-->
								</label>
								<!--end::Label-->

							</div>
							<!--end::Image input-->

							<!--begin::Hint-->
							<div class="form-text">Allowed file types: png, jpg, jpeg.</div>
							<!--end::Hint-->
						</div>
						<!--end::Col-->
					</div>
					<!--end::Input group-->
				
					<!--begin::Input group-->
					<div class="d-flex flex-column mb-5 fv-row">
						<!--begin::Label-->
						<label class="fs-6-5 fw-semibold mb-2">Email</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input class="form-control form-control-solid"  placeholder="@User.Identity?.Name" disabled />
						<!--end::Input-->
					</div>
					<!--end::Input group-->


					<!--begin::Input group-->
					<div class="row mb-5">
						<!--begin::Col-->
						<div class="col-md-6 fv-row">
							<!--begin::Label-->
							<label asp-for="FirstName" class="required fs-6-5 fw-semibold mb-2">First name</label>
							<!--end::Label-->
							<!--begin::Input-->
							<input asp-for="FirstName" type="text" class="form-control form-control-solid"  />
							<!--end::Input-->
							<span asp-validation-for="FirstName" class="text-danger"></span>
						</div>
						<!--end::Col-->
						<!--begin::Col-->
						<div class="col-md-6 fv-row">
							<!--end::Label-->
							<label asp-for="LastName" class="required fs-6-5 fw-semibold mb-2">Last name</label>
							<!--end::Label-->
							<!--end::Input-->
							<input asp-for="LastName" type="text" class="form-control form-control-solid"  />
							<!--end::Input-->
							<span asp-validation-for="LastName" class="text-danger"></span>
						</div>
						<!--end::Col-->
					</div>
					<!--end::Input group-->
				
					<!--begin::Input group-->
					<div class="d-flex flex-column mb-5 fv-row">
					
						<!--begin::Label-->
						<label asp-for="Address" class="required fs-6-5 fw-semibold mb-2">Address</label>
						<!--end::Label-->
						
						

						<div class="input-group">


							<!--begin::Input-->
							<input asp-for="Address" class="form-control form-control-solid" placeholder="eg: plot r 709 block 17 federal b area karachi pakistan" />
							<!--end::Input-->

							<div class="input-group-prepend">
								<span class="input-group-text fetch-location">
									<svg class="me-3" fill="#000000" height="18px" width="18px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
									     viewBox="0 0 192.906 192.906" xml:space="preserve">
										<g>
											<path d="M190.709,180.102l-47.08-47.076c11.702-14.072,18.752-32.142,18.752-51.831c0-44.77-36.421-81.193-81.188-81.193
		C36.423,0.001,0,36.424,0,81.194c0,44.767,36.423,81.188,81.193,81.188c19.688,0,37.758-7.049,51.829-18.75l47.081,47.077
		c1.464,1.464,3.384,2.196,5.303,2.196c1.919,0,3.839-0.732,5.304-2.197C193.639,187.779,193.639,183.031,190.709,180.102z
		 M15,81.194c0-36.499,29.694-66.193,66.193-66.193c36.496,0,66.188,29.694,66.188,66.193c0,36.496-29.691,66.188-66.188,66.188
		C44.694,147.382,15,117.69,15,81.194z"/>
											<path d="M81.186,41.989c-15.79,0-28.637,12.845-28.637,28.634c0,23.968,22.381,46.622,23.334,47.575
		c1.464,1.464,3.383,2.196,5.303,2.196c1.919,0,3.838-0.732,5.302-2.195c0.953-0.953,23.345-23.607,23.345-47.576
		C109.832,54.835,96.981,41.989,81.186,41.989z M81.168,101.497c-6.045-7.682-13.619-19.864-13.619-30.873
		c0-7.518,6.117-13.634,13.637-13.634c7.524,0,13.646,6.116,13.646,13.634C94.832,82.233,86.776,94.419,81.168,101.497z"/>
										</g>
									</svg>
									<span class="fs-6-5">Fetch Auto</span>
								</span>
							</div>
						</div>
						<span asp-validation-for="Address" class="text-danger"></span>
						<div class="text-gray-600 fs-7 mt-1">
							<i class="las la-info-circle"></i> We use your location to show you a customized feed of content nearby.
						</div>
					</div>
					<!--end::Input group-->

					<div class="row mt-4">
						<div class="col">
							<div id="map"></div>
						</div>
						<div class="col d-flex flex-column justify-content-center disabled-div">

							<h4 class="mb-4">Internal Location Data</h4>
							
							<!--begin::Input group-->
							<div class="d-flex flex-column mb-5 fv-row">
								<!--begin::Label-->
								<label class="fs-6-5 fw-semibold mb-2" asp-for="GoogleAddress">Google Address</label>
								<!--end::Label-->
								<!--begin::Input-->
								<input class="form-control form-control-solid" asp-for="GoogleAddress" id="googleAddress" readonly />
								<!--end::Input-->
								<span asp-validation-for="GoogleAddress" class="text-danger"></span>
							</div>
							<!--end::Input group-->

							<div class="row">
								<div class="col-md-6 fv-row">
									<label asp-for="Latitude" class="fs-6-5 fw-semibold mb-2">Latitude</label>
									<input asp-for="Latitude" type="text" id="latitude" class="form-control form-control-solid" readonly />
									<span asp-validation-for="Latitude" class="text-danger"></span>
								</div>
								<div class="col-md-6 fv-row">
									<label asp-for="Longitude" class="fs-6-5 fw-semibold mb-2">Longitude</label>
									<input asp-for="Longitude" type="text" id="longitude" class="form-control form-control-solid" readonly />
									<span asp-validation-for="Longitude" class="text-danger"></span>
								</div>
							</div>

						</div>
	
					</div>
				</div>

				<div class="card-footer">
					<button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
					<a asp-action="Index" class="ms-2 btn btn-sm btn-secondary">Cancel</a>
				</div>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<script>
        let map, marker, geocoder;

        async function initMap(callback) {
            // 1. Import libraries using the modern method
            const { Map } = await google.maps.importLibrary("maps");
            const { AdvancedMarkerElement } = await google.maps.importLibrary("marker");
            const { PlaceAutocompleteElement } = await google.maps.importLibrary("places");
            // Note: Geocoding library doesn't use importLibrary yet in many versions, 
            // but is available globally if loaded via script tag.

            const initialPosition = { lat: 37.7749, lng: -122.4194 };

            // 2. Initialize Map
            map = new Map(document.getElementById("map"), {
                zoom: 13,
                center: initialPosition,
                mapId: "d51644aa08ca7cea704f06a2 ", // Required for AdvancedMarkerElement and New API features
                mapTypeControl: false,
                streetViewControl: false
            });

            // 3. Create the New Autocomplete Component
            const autocomplete = new PlaceAutocompleteElement();
            autocomplete.id = "place-autocomplete-input";
	        autocomplete.placeholder = "Search a place...";
	        autocomplete.setAttribute("input-placeholder", "Search a place...");
            
            // Push it inside the map controls
            map.controls[google.maps.ControlPosition.TOP_LEFT].push(autocomplete);

            // 4. Create Marker (AdvancedMarkerElement is required for new maps features)
            marker = new AdvancedMarkerElement({
                map: map,
                position: initialPosition,
                gmpDraggable: true // New property for draggable
            });

            // 5. Initialize Geocoder (Legacy service still used for reverse geocoding clicks)
            geocoder = new google.maps.Geocoder();

            // EVENT 1: User selects a place from New Autocomplete
	        autocomplete.addEventListener("gmp-select", async ({ placePrediction }) => {
            // autocomplete.addEventListener("gmp-placeselect", async ({ place }) => {
		        

		        const place = placePrediction.toPlace();
		        // await place.fetchFields({
			    //     fields: ['displayName', 'formattedAddress', 'location'],
		        // });
		        //
		        // // If the place has a geometry, then present it on a map.
		        // if (place.viewport) {
			    //     innerMap.fitBounds(place.viewport);
		        // } else {
			    //     innerMap.setCenter(place.location);
			    //     innerMap.setZoom(17);
		        // }
				
				
                await place.fetchFields({ fields: ["displayName", "formattedAddress", "location"] });

                if (!place.location) return;

                // Move map and marker
                map.setCenter(place.location);
                map.setZoom(17);
                marker.position = place.location;

                // Update Fields
                fillInputs(place.formattedAddress, place.location.lat(), place.location.lng());
            });

            // EVENT 2: Map Click
            map.addListener("click", (e) => {
	            const clickedLocation = e.latLng;
	            marker.position = clickedLocation; // Update marker position
	            geocodePosition(clickedLocation);
            });
        }

        const autocomplete = document.getElementById("autocomplete");

        autocomplete.addEventListener("gmp-placeselect", async () => {
	        const place = autocomplete.getPlace();
	        console.log("Selected place:", place);

	        await place.fetchFields({
		        fields: ["displayName", "formattedAddress", "location"]
	        });

	        if (!place.location) return;

	        map.setCenter(place.location);
	        map.setZoom(17);
	        marker.position = place.location;

	        fillInputs(
		        place.formattedAddress,
		        place.location.lat(),
		        place.location.lng()
	        );
        });


        function geocodePosition(pos) {
            geocoder.geocode({ location: pos }, (results, status) => {
                if (status === "OK" && results[0]) {
                    fillInputs(results[0].formatted_address, typeof pos.lat === 'function' ? pos.lat() : pos.lat, typeof pos.lng === 'function' ? pos.lng() : pos.lng);
                } else {
                    console.error("Geocode failed: " + status);
                }
            });
        }

        function fillInputs(address, lat, lng) {
            document.getElementById("googleAddress").value = address;
            document.getElementById("latitude").value = lat;
            document.getElementById("longitude").value = lng;
        }

        window.initMap = initMap;
    </script>
	
	<script>
		$(document).ready(function () {

			const latitude = $('#latitude');
			const longitude = $('#longitude');
			
			$('.fetch-location').on('click', function () {
				if (navigator.geolocation) {
					navigator.geolocation.getCurrentPosition(fillLatLng, showError);
				} else {
					toastr.error("Geolocation is not supported by this browser.");
				}
			});

			function fillLatLng(position) {

				Swal.fire({
					title: 'Fetching...',
					text: 'Please wait while we are fetching your location.',
					allowOutsideClick: false, // Prevent closing by clicking outside
					allowEscapeKey: false,   // Prevent closing with Escape key
					showConfirmButton: false, // Hide the confirm button
					didOpen: () => {
						Swal.showLoading(); // Show the loading spinner
					}
				});
				
				const apiKey = "AIzaSyDjRaFkJuFq8lYhm3jJOWuNvqwdu990wJs";
				const lat = position.coords.latitude;
				const lng = position.coords.longitude;
				
				latitude.val(lat);
				longitude.val(lng);

				const url = `https://maps.googleapis.com/maps/api/geocode/json?latlng=${lat},${lng}&result_type=street_address&key=${apiKey}`;
				
				axios.get(url)
					.then(function ({ data }) {

						console.log( data )

						if (data.status === "OK" && data.results.length > 0) {

							let finalAddress = data.results[0].formatted_address;

							console.log("Selected Address:", finalAddress);
						}
						
						Swal.close(); // Close the loading dialog
						
					})
				
			}

			function showError(error) {
				switch (error.code) {
					case error.PERMISSION_DENIED:
						toastr.error("User denied the request for Geolocation.");
						break;
					case error.POSITION_UNAVAILABLE:
						toastr.error("Location information is unavailable.");
						break;
					case error.TIMEOUT:
						toastr.error("The request to get user location timed out.");
						break;
					case error.UNKNOWN_ERROR:
						toastr.error("An unknown error occurred.");
						break;
				}
			}
			
		});
	</script>

	<script
      src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDjRaFkJuFq8lYhm3jJOWuNvqwdu990wJs&callback=initMap&loading=async&v=weekly"
      defer
    ></script>
	<partial name="_ValidationScriptsPartial" />
	
}
